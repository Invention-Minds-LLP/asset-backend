  asset   Asset @relation(fields: [assetId], references: [id])

  ticketId Int?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  quantity  Int
  costAtUse Decimal? @db.Decimal(12, 2)

  usedById Int?
  usedBy   Employee? @relation(fields: [usedById], references: [id])

  reason String?

  usedAt DateTime @default(now())

  @@index([assetId, usedAt])
  @@map("sparepartusage")
}

model Consumable {
