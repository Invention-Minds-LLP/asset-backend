  maintenanceHistories MaintenanceHistory[]

  @@index([assetId, nextDueAt])
  @@map("maintenanceschedule")
}

/**
 * =========================
 * NEW: AMC/CMC contracts
 * =========================
 */
model ServiceContract {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  contractType   String // AMC | CMC
  contractNumber String?

  startDate DateTime
  endDate   DateTime

  includesParts Boolean? // typically false for AMC, true for CMC
  includesLabor Boolean?

  visitsPerYear          Int? // kept for backward compat
  regularVisitsPerYear   Int? // planned preventive maintenance visits
  emergencyVisitsPerYear Int? // emergency call-out visits included
  cost                   Decimal? @db.Decimal(12, 2) // If free/warranty, keep null or 0
  currency               String?

  document String?
  terms    String? @db.Text

  status String? // ACTIVE | EXPIRED | TERMINATED

  // Vendor SLA commitments (contractual)
  vendorResponseValue   Int? // e.g. 4
  vendorResponseUnit    String? // HOURS | DAYS
  vendorResolutionValue Int? // e.g. 24
  vendorResolutionUnit  String? // HOURS | DAYS

  // Uptime commitment. The SLA fields above cover how fast the vendor must
  // respond; this covers how much of the year the machine must actually work.
  uptimeCommitmentPercent Decimal? @db.Decimal(5, 2)
  /// Money off per percentage point below the commitment. Some contracts
  /// instead give free extension days — record whichever the contract says.
  penaltyPerPercentPoint  Decimal? @db.Decimal(12, 2)
  penaltyMaxPercent       Decimal? @db.Decimal(5, 2) // cap, as % of contract value
  /// Hours the asset is expected to be available in a year. Drives the
  /// denominator when uptime is worked out.
  plannedHoursPerYear     Int?
  /// Planned maintenance and calibration usually do not count against uptime.
  excludePlannedDowntime  Boolean  @default(true)

  // Renewal. A contract that lapses unnoticed is the commonest way an
  // institution ends up paying list price for a breakdown.
  autoRenew           Boolean  @default(false)
  renewalNoticeDays   Int?     @default(60)
  maxEscalationPercent Decimal? @db.Decimal(5, 2) // what the vendor may raise it by

  /// Where this contract came from — the warranty it followed, or the contract
  /// it renewed. Gives an asset one continuous cover history.
  precededByWarrantyId Int?
  precededByWarranty   Warranty? @relation("WarrantyToContract", fields: [precededByWarrantyId], references: [id])
  renewsContractId     Int?
  renewsContract       ServiceContract?  @relation("ContractRenewalChain", fields: [renewsContractId], references: [id])
  renewedBy            ServiceContract[] @relation("ContractRenewalChain")

  createdBy String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  maintenanceHistories MaintenanceHistory[]
  serviceVisits        ServiceVisit[]
  serviceInvoices      ServiceInvoice[]
  uptimeAssessments    UptimeAssessment[]
  renewalDecisions     CoverRenewal[]       @relation("RenewalFromContract")

  @@index([assetId, endDate])
  @@map("servicecontract")
}

/**
 * The decision that has to be taken before cover runs out: renew, move to a
 * different contract type, go on-call, or let it lapse deliberately.
 *
 * Raised automatically when a warranty or contract comes inside its notice
 * period, so the choice is made on purpose rather than by default.
 */
model CoverRenewal {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  /// WARRANTY | CONTRACT — what is running out.
  sourceType String
  warrantyId Int?
  warranty   Warranty? @relation("WarrantyRenewals", fields: [warrantyId], references: [id])
  contractId Int?
  contract   ServiceContract? @relation("RenewalFromContract", fields: [contractId], references: [id])

  coverEndsOn DateTime
  raisedOn    DateTime @default(now())

  status String @default("PENDING") // PENDING | DECIDED | INDENTED | ORDERED | COVERED | LAPSED | CANCELLED

  /// RENEW_AMC | RENEW_CMC | UPGRADE_TO_CMC | DOWNGRADE_TO_AMC | ON_CALL |
  /// REPLACE_ASSET | LET_LAPSE
  decision       String?
  decisionReason String?   @db.Text
  decidedById    Int?
  decidedBy      Employee? @relation("CoverRenewalDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?

  /// What the vendor is asking, and what it cost last time — the two numbers
  /// the decision actually turns on.
  quotedAmount   Decimal? @db.Decimal(14, 2)
  previousAmount Decimal? @db.Decimal(14, 2)

  /// Downstream linkage once the decision becomes procurement.
  indentId        Int?
  purchaseOrderId Int?
  newContractId   Int?

  /// Set when the asset went uncovered — the gap is what an auditor asks about.
  lapsedAt       DateTime?
  uncoveredDays  Int?

  notes String? @db.Text

  remindersSent Int      @default(0)
  lastReminder  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, coverEndsOn])
  @@index([assetId])
  @@map("coverrenewal")
}

/**
 * Whether the vendor actually kept the machine running, measured over a period
 * of the contract, and what that is worth if they did not.
 */
model UptimeAssessment {
  id Int @id @default(autoincrement())

  contractId Int
  contract   ServiceContract @relation(fields: [contractId], references: [id])

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  periodLabel String

  committedPercent Decimal @db.Decimal(5, 2)
  plannedHours     Decimal @db.Decimal(10, 2)
  downtimeHours    Decimal @db.Decimal(10, 2)
  /// Downtime that does not count — planned maintenance, calibration, and
  /// anything the assessor excluded by hand.
  excludedHours    Decimal @db.Decimal(10, 2) @default(0)
  actualPercent    Decimal @db.Decimal(5, 2)
  shortfallPercent Decimal @db.Decimal(5, 2) @default(0)

  penaltyAmount Decimal @db.Decimal(14, 2) @default(0)
  /// How the figure was arrived at, in words, for the vendor conversation.
  workings      String? @db.Text

  /// Breakdowns counted, so the assessment can be argued from the tickets.
  incidentCount Int @default(0)

  status String @default("DRAFT") // DRAFT | CONFIRMED | DISPUTED | RECOVERED | WAIVED

  waivedReason String?   @db.Text
  waivedById   Int?
  waivedBy     Employee? @relation("UptimeWaivedBy", fields: [waivedById], references: [id])
  waivedAt     DateTime?

  /// Where the money came off.
  serviceInvoiceId Int?
  recoveredAt      DateTime?

  assessedById Int?
  assessedBy   Employee? @relation("UptimeAssessedBy", fields: [assessedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([contractId, periodStart, periodEnd])
  @@index([assetId])
  @@map("uptimeassessment")
}

/**
 * Damages for late delivery. Computed from the goods receipt against the date
 * the order promised, and held against the vendor's balance payment until it is
 * either recovered or deliberately waived.
 */
model LiquidatedDamage {
  id Int @id @default(autoincrement())

  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  externalPoId    Int?
  goodsReceiptId  Int?
  goodsReceipt    GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])

  vendorId Int?

  promisedDate DateTime
  actualDate   DateTime
  graceDays    Int @default(0)
  delayDays    Int

  /// The value the charge is worked out on, and the terms it came from.
  basisAmount      Decimal @db.Decimal(14, 2)
  basis            String  @default("DELAYED_VALUE")
  percentPerWeek   Decimal @db.Decimal(5, 2)
  maxPercent       Decimal @db.Decimal(5, 2)
  cappedAt         Boolean @default(false)

  computedAmount Decimal @db.Decimal(14, 2)
  workings       String? @db.Text

  status String @default("COMPUTED") // COMPUTED | CONFIRMED | DISPUTED | WAIVED | RECOVERED

  /// A delay the vendor is not answerable for — a site not ready, a customs
  /// hold, a change the institution asked for.
  waivedReason String?   @db.Text
  waivedById   Int?
  waivedBy     Employee? @relation("LdWaivedBy", fields: [waivedById], references: [id])
  waivedAt     DateTime?

  recoveredInVoucherId Int?
  recoveredAt          DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([purchaseOrderId])
  @@index([status])
  @@map("liquidateddamage")
}

/**
 * PLACEMENT AND REAGENT RENTAL
 *
 * The supplier puts an analyser on site for nothing, or for a token rent, and
 * the institution commits to buying a minimum of reagents from them. The
 * machine is used every day, is serviced, breaks down, and has to be produced
 * at audit — but it is not owned, so it must never be depreciated or written
 * off, and it never belonged in the capital budget.
 *
 * What actually costs money is the commitment. Miss it and the shortfall is
 * billed, and the effective cost per test quietly overtakes what buying the
 * machine outright would have cost. That comparison is the point of this.
 */
model PlacementAgreement {
  id Int @id @default(autoincrement())

  agreementNumber String  @unique
  vendorId        Int
  vendor          Vendor  @relation("VendorPlacements", fields: [vendorId], references: [id])

  departmentId Int?
  department   Department? @relation("DepartmentPlacements", fields: [departmentId], references: [id])

  /// FREE_PLACEMENT — no rent, commitment only
  /// RENTAL — a monthly rent as well
  /// COST_PER_TEST — billed per reportable test, machine and reagent bundled
  /// RENT_CUM_PURCHASE — rent counts towards a buyout
  model String @default("FREE_PLACEMENT")

  startDate DateTime
  endDate   DateTime
  minimumTenureMonths Int?

  monthlyRent Decimal? @db.Decimal(12, 2)

  // ── The commitment ─────────────────────────────────────────────────
  /// VALUE — rupees of reagent a month. VOLUME — a number of tests a month.
  commitmentType         String   @default("VALUE")
  committedValuePerMonth Decimal? @db.Decimal(14, 2)
  committedTestsPerMonth Int?
  ratePerTest            Decimal? @db.Decimal(12, 2)

  /// What happens when the commitment is missed — usually the shortfall is
  /// billed at the reagent rate.
  shortfallBasis  String?  @default("BILL_SHORTFALL") // BILL_SHORTFALL | CARRY_FORWARD | NONE
  shortfallTerms  String?  @db.Text

  /// The machine cannot be run on anyone else's reagents.
  reagentExclusivity Boolean @default(true)

  // ── The way out ────────────────────────────────────────────────────
  buyoutOffered     Boolean  @default(false)
  buyoutPrice       Decimal? @db.Decimal(14, 2)
  buyoutAfterMonths Int?
  exitPenalty       Decimal? @db.Decimal(14, 2)
  exitNoticeDays    Int?     @default(90)

  /// What the machine is worth, for insurance and custody — never for
  /// depreciation, because the institution does not own it.
  notionalValue Decimal? @db.Decimal(14, 2)

  /// What the same machine would have cost to buy. Without it there is nothing
  /// to compare the running cost against.
  outrightPurchasePrice Decimal? @db.Decimal(14, 2)

  status String @default("ACTIVE") // DRAFT | ACTIVE | EXPIRED | TERMINATED | BOUGHT_OUT | RETURNED

  terminatedAt     DateTime?
  terminationReason String?  @db.Text
  returnedAt       DateTime?
  boughtOutAt      DateTime?

  documentUrl String?
  terms       String? @db.Text
  notes       String? @db.Text

  assets       Asset[]
  consumptions PlacementConsumption[]

  createdById Int?
  createdBy   Employee? @relation("PlacementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([vendorId])
  @@index([status, endDate])
  @@map("placementagreement")
}

