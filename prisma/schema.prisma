// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AssignmentStatus {
  PENDING
  ACKNOWLEDGED
  REJECTED
  RETURNED
}

enum AssignmentAction {
  CREATED
  ACKNOWLEDGED
  REJECTED
  REASSIGNED
  RETURNED
}

enum EmployeeRole {
  CEO_COO
  HOD
  SUPERVISOR
  EXECUTIVE
  FINANCE
  OPERATIONS
  CFO
}

enum AssignmentStage {
  HOD_SOURCE
  SUPERVISOR
  HOD_TARGET
  END_USER
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  WORK_COMPLETED
  RESOLVED
  TERMINATED
  CLOSED
  REJECTED
}

enum TicketAssignmentAction {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

enum ChecklistRunStatus {
  DUE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ChecklistResult {
  PASS
  FAIL
  NA
}

enum TicketTransferType {
  INTERNAL_DEPARTMENT
  EXTERNAL_VENDOR
  EXTERNAL_SERVICE
}

enum TicketTransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum AssetSlaCategory {
  LOW
  MEDIUM
  HIGH
}

enum SlaLevel {
  L1
  L2
  L3
}

enum AcknowledgementPurpose {
  ASSIGNMENT
  TRANSFER_RETURN
  TRANSFER_OUT
  MAINTENANCE
}

model Asset {
  id           Int         @id @default(autoincrement())
  assetId      String      @unique
  // Permanent stores reference. Format: STR-{ORG}-{CAT}-FY{YYYY}-{YY}-{NNNNN}
  // Generated when stores user fills basic details, never overwritten.
  storeAssetId String?     @unique
  assetName    String
  assetType    String
  assetNature  AssetNature @default(TANGIBLE)

  // Intangible-specific
  intangibleSubType     IntangibleSubType?
  usefulLifeYears       Int?
  amortizationMethod    AmortizationMethod?
  amortizationStartDate DateTime?
  residualValuePercent  Float?

  assetCategoryId   Int
  assetCategory     AssetCategory @relation(fields: [assetCategoryId], references: [id])
  // Optional sub-type (e.g. "Desktop Monitor"), shown in the Specification section.
  // Flat/global master; drives repair-engineer routing via SubTypeSupportConfig.
  assetSubTypeId    Int?
  assetSubType      AssetSubType? @relation(fields: [assetSubTypeId], references: [id])
  serialNumber      String?       @unique
  purchaseDate      DateTime?
  modeOfProcurement String        @default("PURCHASE") // PURCHASE | DONATION | LEASE | RENTAL 

  manufacturer       String?
  modelNumber        String?
  countryOfOrigin    String?
  regulatoryApproval String? // FDA/CE/BIS certification number

  referenceCode String?  @unique
  isBranded     Boolean? @default(false)
  isAssembled   Boolean? @default(false)
  isCustomized  Boolean? @default(false)
  customDetails String?  @db.Text

  hasSpecifications Boolean? @default(false)
  physicalCondition String? // EXCELLENT | GOOD | FAIR | POOR

  installedAt DateTime?

  // PURCHASE
  invoiceNumber       String?
  purchaseOrderNo     String?
  purchaseOrderDate   DateTime?
  deliveryDate        DateTime?
  purchaseCost        Decimal?  @db.Decimal(12, 2)
  purchaseVoucherNo   String?
  purchaseVoucherDate DateTime?
  purchaseVoucherId   Int?

  // DONATION
  donorName        String?
  donationDate     DateTime?
  assetCondition   String? // NEW / USED
  estimatedValue   Decimal?  @db.Decimal(12, 2)
  donationDocument String?

  // LEASE
  leaseStartDate   DateTime?
  leaseEndDate     DateTime?
  leaseAmount      Decimal?  @db.Decimal(12, 2)
  leaseRenewalDate DateTime?
  leaseContractDoc String?

  // RENTAL
  rentalStartDate    DateTime?
  rentalEndDate      DateTime?
  rentalAmount       Decimal?  @db.Decimal(12, 2)
  rentalAgreementDoc String?

  // Physical + Functional Inspection (for Donation / Lease / Rental)
  inspectionDoneBy           String? // who performed the inspection
  inspectionCondition        String? // SEALED | UNSEALED | DAMAGED | GOOD | FAIR
  inspectionRemark           String?   @db.Text
  physicalInspectionStatus   String? // PASS | FAIL | PENDING
  physicalInspectionDate     DateTime?
  functionalInspectionStatus String? // PASS | FAIL | PENDING
  functionalInspectionDate   DateTime?
  functionalTestNotes        String?   @db.Text

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // GRN
  grnNumber         String?
  grnDate           DateTime?
  grnValue          Decimal?  @db.Decimal(12, 2)
  inspectionStatus  String?
  inspectionRemarks String?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  targetDepartmentId Int? // NEW (where end user belongs)
  targetDepartment   Department? @relation("TargetDept", fields: [targetDepartmentId], references: [id])

  // Primary supervisor (custodian). Kept as a single FK for the handover flow
  // and default ticket routing; the full set of (shift/co-)supervisors lives in
  // AssetSupervisor. Primary is mirrored there with isPrimary=true.
  supervisorId Int?
  supervisor   Employee? @relation("AssetSupervisor", fields: [supervisorId], references: [id])

  // All supervisors assigned to this asset (incl. primary) — supports shift-wise
  // duty where several supervisors share one asset.
  supervisors AssetSupervisor[]

  allottedToId    Int?
  allottedTo      Employee? @relation("AssetEndUser", fields: [allottedToId], references: [id])
  rfidCode        String?   @unique
  qrCode          String?   @unique
  qrGeneratedAt   DateTime?
  qrLabelPrinted  Boolean?  @default(false)

  // Physical sticker on the asset. Distinct from qrLabelPrinted (which the bulk
  // print endpoint sets automatically) — this is someone confirming the label is
  // actually stuck on the equipment. Locked once set; only unlock roles can clear it.
  qrStickered        Boolean?  @default(false)
  qrStickeredAt      DateTime? // the date the sticker went on, entered by the user
  qrStickeredById    Int?
  qrStickeredBy      Employee? @relation("AssetQrStickeredBy", fields: [qrStickeredById], references: [id])
  qrStickeredRemarks String?   @db.Text

  currentLocation String?
  fromLocation    String?
  toLocation      String?
  status          String
  assetPhoto      String?

  // ── CCTV marker-based location tracking (ArUco/AprilTag) ──
  // locationTracked: opt-in — only "selected assets" are watched by the reader.
  // markerId: the fiducial marker's integer ID printed on the asset; the CCTV
  // reader reports this, and ingest resolves it back to this asset.
  locationTracked Boolean @default(false)
  markerId        Int?

  sourceType             String? // NEW | INVENTORY
  sourceReference        String?
  remarks                String?           @db.Text
  // Sub-asset flagged because its value is >= 40% of its parent's value.
  // Created as a sub-asset anyway, but surfaced in the UI for review.
  exceedsParentThreshold Boolean?          @default(false)
  // Hospital-critical classification (optional)
  criticalityLevel       String? // LOW | MEDIUM | HIGH | LIFE_SUPPORT
  riskClass              String? // CLASS_I | CLASS_II | CLASS_III
  // Condition/health (optional)
  workingCondition       String? // WORKING | PARTIAL | NOT_WORKING
  healthScore            Int?
  lastInspectionDate     DateTime?
  slaExpectedValue       Int?
  slaExpectedUnit        String?
  slaResolutionValue     Int?
  slaResolutionUnit      String?
  slaNextDueAt           DateTime?
  slaBreached            Boolean?
  slaCategory            AssetSlaCategory?
  // CATEGORY = SLA times inherited from the AssetSlaMatrix for this category;
  // CUSTOM = times entered manually on the asset.
  slaMode                String?           @default("CATEGORY")
  // Chosen matrix level (L1/L2/L3) — used to pick the SLA matrix row in CATEGORY mode.
  slaLevel               String?
  lastSlaServiceDate     DateTime?

  // Audit / verification
  lastAuditDate  DateTime?
  auditedBy      String?
  warrantyStatus String? // UNDER_WARRANTY | EXPIRED | NO_WARRANTY

  // Retirement / disposal
  retiredDate          DateTime?
  retiredReason        String?
  expectedLifetime     Int?
  expectedLifetimeUnit String?
  // Service coverage type (e.g. 24/7, 8/5, 9/6)
  serviceCoverageType  String? // 24/7 | 8/5 | 9/6 | 12/7 | CUSTOM
  // HOD approval tracking before Asset ID is issued
  hodApprovalStatus    String? // PENDING | APPROVED | REJECTED
  hodApprovalById      Int?
  hodApprovalAt        DateTime?
  hodApprovalRemarks   String?   @db.Text
  retiredBy            String?
  disposalMethod       String? // SOLD | SCRAPPED | DONATED | RETURNED_TO_VENDOR | AUCTION
  disposalValue        Decimal?  @db.Decimal(12, 2)
  disposalDate         DateTime?
  disposalApprovedBy   String?
  disposalCertificate  String? // URL for certificate of destruction

  // Sub-assets (optional hierarchy)
  parentAssetId Int?
  parentAsset   Asset?  @relation("SubAssets", fields: [parentAssetId], references: [id])
  subAssets     Asset[] @relation("SubAssets")

  replacedBySubAsset  SubAssetReplacement[] @relation("OldSubAsset")
  replacingSubAsset   SubAssetReplacement[] @relation("NewSubAsset")
  parentOfReplacement SubAssetReplacement[] @relation("ParentOfReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdById Int?
  updatedById Int?

  specificationSummary String? @db.Text
  organogramNotes      String? @db.Text
  ticketHierarchyNotes String? @db.Text
  pmFormatNotes        String? @db.Text

  // Staging store for an IN_STORE (not-yet-deployed) asset — which warehouse/sub-store
  // it physically sits in. Set on goods receipt, updated by store transfers, and
  // cleared when the asset is deployed into a department.
  currentStoreId    Int?
  currentStore      Store?    @relation("AssetCurrentStore", fields: [currentStoreId], references: [id])
  // When the asset entered its current store — drives "days in store" aging.
  currentStoreSince DateTime?

  // Denormalized cache of the asset's current branch — mirrors the branchId of the
  // active AssetLocation row (source of truth). Updated in the SAME transaction that
  // flips the active location (see src/lib/assetLocation.ts); never edited directly.
  // Null = asset has no active location yet (in store / in transit / never placed).
  currentBranchId Int?
  currentBranch   Branch? @relation("AssetCurrentBranch", fields: [currentBranchId], references: [id])

  depreciation AssetDepreciation?
  insurance    AssetInsurance[]
  locations    AssetLocation[]
  transfers    AssetTransferHistory[]

  maintenanceHistory MaintenanceHistory[]

  warranties                   Warranty[]
  tickets                      Ticket[]
  serviceContracts             ServiceContract[]
  coverRenewals                CoverRenewal[]
  uptimeAssessments            UptimeAssessment[]
  sanitisations                DataSanitisation[]
  serviceDocuments             Document[]
  qrScans                      QRScanLog[]
  gatePasses                   GatePass[]
  gatePassItems                GatePassItem[]                 @relation("GatePassItemAsset")
  scanLogs                     AssetScanLog[]
  notifications                Notification[]
  assignments                  AssetAssignment[]
  specifications               AssetSpecification[]
  employee                     Employee?                      @relation(fields: [employeeId], references: [id])
  employeeId                   Int?
  depreciationLogs             DepreciationLog[]
  insuranceClaims              InsuranceClaim[]
  maintenanceSchedules         MaintenanceSchedule[]
  sparePartUsages              SparePartUsage[]
  calibrationSchedules         CalibrationSchedule[]
  calibrationHistory           CalibrationHistory[]
  preventiveChecklistTemplates PreventiveChecklistTemplate[]
  preventiveChecklistRuns      PreventiveChecklistRun[]
  acknowledgementTemplates     AssetAcknowledgementTemplate[]
  acknowledgementRuns          AssetAcknowledgementRun[]
  pmChecklistTemplates         PMChecklistTemplate[]
  pmChecklistRuns              PMChecklistRun[]
  calibrationTemplates         CalibrationChecklistTemplate[]
  supportMatrixes              AssetSupportMatrix[]
  disposals                    AssetDisposal[]
  eWasteRecords                EWasteRecord[]
  auditItems                   AssetAuditItem[]               @relation("AuditItems")
  indentFulfillments           AssetIndent[]                  @relation("IndentFulfilledAsset")
  exitAssets                   EmployeeExitAsset[]            @relation("ExitAssets")
  serviceVisits                ServiceVisit[]                 @relation("AssetServiceVisits")
  revenueEntries               AssetRevenueEntry[]
  serviceInvoices              ServiceInvoice[]
  decisionLogs                 DecisionEngineLog[]            @relation("DecisionLogs")

  // Procurement linkage (optional — nullable FKs, Asset works without PO/GRA)
  purchaseOrderId   Int?
  purchaseOrderRef  PurchaseOrder? @relation("POAssets", fields: [purchaseOrderId], references: [id])
  goodsReceiptId    Int?
  goodsReceiptRef   GoodsReceipt?  @relation("GRAAssets", fields: [goodsReceiptId], references: [id])
  workOrderCapexId  Int?
  workOrderCapexRef WorkOrder?     @relation("CapExAssets", fields: [workOrderCapexId], references: [id])

  // Accounts module — purchase vouchers where this asset is referenced as the subject
  purchaseVouchers PurchaseVoucher[] @relation("AssetPurchaseVouchers")

  // Work orders on this asset
  workOrders      WorkOrder[]           @relation("AssetWorkOrders")
  costAllocations AssetCostAllocation[] @relation("CostAllocations")
  rateCard        AssetRateCard?        @relation("AssetRateCard")
  dailyUsageLogs  AssetDailyUsageLog[]  @relation("DailyUsageLogs")

  // True when this asset is revenue-generating (e.g. revenue-share/rental device).
  // Drives visibility of the Revenue Log section + dropdown filter.
  isRevenueLogApplicable Boolean? @default(false)

  // ── Legacy Asset Onboarding ──────────────────────────────────────────────
  // Used when onboarding assets from companies with 2+ years of existing history.
  // Captures all pre-system costs as opening balances so dashboards show true TCO.
  isLegacyAsset             Boolean?  @default(false)
  dataAvailableSince        DateTime? // date from which live tracking begins in this system
  historicalMaintenanceCost Decimal?  @db.Decimal(12, 2) // total repair/service spend before system
  historicalSparePartsCost  Decimal?  @db.Decimal(12, 2) // total spare parts/consumables before system
  historicalOtherCost       Decimal?  @db.Decimal(12, 2) // misc historical costs (transport, calibration etc.)
  historicalCostAsOf        DateTime? // "costs as of this date" — the closing date of pre-system history
  historicalCostNote        String?   @db.Text // free text explanation / source of figures

  // ── Legacy Migration (audit cut-off freeze) ─────────────────────────────
  // For 5+ year old institutes onboarding with audited FA register.
  // Engine NEVER computes depreciation for periods before migrationDate.
  migrationMode               String? // GRANULAR | PROPORTIONAL | CARRY_AS_NEW
  migrationDate               DateTime? // cut-off date; opening balances frozen as of this date
  originalPurchaseDate        DateTime? // pre-migration acquisition date (for half-year decision in migration FY)
  originalCost                Decimal?  @db.Decimal(14, 2) // pre-migration gross block
  accDepAtMigration           Decimal?  @db.Decimal(14, 2) // accumulated dep frozen at migration
  openingWdvAtMigration       Decimal?  @db.Decimal(14, 2) // opening WDV at migration (= cost − accDep)
  auditedBookValueAtMigration Decimal?  @db.Decimal(14, 2) // for variance reconciliation
  auditReferenceId            String? // auditor sign-off ref (firm + report no)
  migrationApprovedById       Int? // CFO who signed off
  migrationApprovedAt         DateTime?
  migrationNotes              String?   @db.Text

  // ── Asset Pool (phased digitization) ────────────────────────────────────
  // When an asset is extracted from a bulk pool and individually entered, link it back.
  assetPoolId        Int?
  financialYearAdded String? // FY in which this individual record was digitized, e.g. "FY2023-24"
  assetPool          AssetPool? @relation(fields: [assetPoolId], references: [id])

  // ── Funding source ──────────────────────────────────────────────────────
  // Drives two unrelated rules from one field:
  //   • charitable entities — cost claimed as application of income cannot
  //     also be depreciated, so depreciation is suppressed
  //   • grant-funded assets — conditions on use, disposal and reporting
  fundingSource       AssetFundingSource?
  // Set when the acquisition cost was claimed as application of income in the
  // year of purchase. The flag the depreciation engine actually reads.
  costClaimedAsApplication Boolean @default(false)
  grantReference      String? // scheme / sanction number
  grantAuthority      String? // who funded it
  grantConditions     String? @db.Text // restrictions on use or disposal
  fundingNotes        String? @db.Text

  // ── Ownership ───────────────────────────────────────────────────────────
  // Not everything standing in a department belongs to the institution. An
  // analyser placed by a reagent supplier is on site, is serviced, breaks down
  // and has to be found at audit — but it is not an asset of the institution,
  // so it must never be depreciated, insured as owned, or written off.
  // OWNED | PLACEMENT | RENTAL | LEASED | LOANED | DONATED_CONDITIONAL
  ownershipType String @default("OWNED")

  placementAgreementId Int?
  placementAgreement   PlacementAgreement? @relation(fields: [placementAgreementId], references: [id])

  // ── Capitalisation ──────────────────────────────────────────────────────
  // Cost accumulates against the work in progress and transfers here when the
  // asset is ready for use. The capitalisation date, not the invoice date, is
  // what depreciation should run from.
  cwipId         Int?
  cwip           CapitalWorkInProgress? @relation("CwipAssets", fields: [cwipId], references: [id])
  capitalisedAt  DateTime?
  capitalisedCost Decimal? @db.Decimal(14, 2)

  indentStoreIssues     IndentStoreIssue[]
  commissioningSignoffs CommissioningSignoff[]
  licences              AssetLicence[]         @relation("AssetLicences")
  depreciationBooks     AssetDepreciationBook[] @relation("AssetDepBooks")

  @@index([status])
  @@index([assetCategoryId])
  @@index([departmentId])
  @@index([vendorId])
  @@index([currentBranchId])
  @@map("asset")
}

model Warranty {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  warrantyStart   DateTime
  warrantyEnd     DateTime
  daysToExpiry    Int?
  isUnderWarranty Boolean
  alertSent       Boolean  @default(false)

  warrantyType      String? // OEM | EXTENDED | SELLER | SERVICE | OTHER
  warrantyProvider  String?
  vendorId          Int?
  vendor            Vendor? @relation(fields: [vendorId], references: [id])
  warrantyReference String?
  coverageDetails   String? @db.Text
  exclusions        String? @db.Text
  supportContact    String?
  supportEmail      String?
  termsUrl          String?
  remarks           String? @db.Text

  createdById Int?
  updatedById Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // What happens when it runs out.
  renewalDecisions  CoverRenewal[]    @relation("WarrantyRenewals")
  followOnContracts ServiceContract[] @relation("WarrantyToContract")

  @@index([assetId])
  @@index([assetId, isActive])
  @@map("warranty")
}

model Ticket {
  id           Int        @id @default(autoincrement())
  ticketId     String     @unique
  raisedById   Int?
  raisedBy     Employee?  @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  departmentId Int
  department   Department @relation("TicketDepartment", fields: [departmentId], references: [id])
  assetId      Int
  asset        Asset      @relation(fields: [assetId], references: [id])

  issueType    String
  detailedDesc String       @db.Text
  priority     String
  photoOfIssue String?
  location     String
  status       TicketStatus @default(OPEN)

  // ✅ assignment control
  assignedToId Int?
  assignedTo   Employee? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  assignedById Int?
  assignedBy   Employee? @relation("TicketAssignedBy", fields: [assignedById], references: [id])

  owningDepartmentId Int?
  owningDepartment   Department? @relation("TicketOwningDept", fields: [owningDepartmentId], references: [id])

  // ✅ transfer control
  isTransferred Boolean @default(false)
  transferCount Int     @default(0) // optional (if you want to limit)

  reassignCount  Int       @default(0) // max 2
  lastAssignedAt DateTime?
  assignmentNote String?   @db.Text

  // ✅ termination by HOD
  terminatedAt    DateTime?
  terminatedById  Int?
  terminationNote String?   @db.Text

  // ✅ closing by raised person
  closedAt     DateTime?
  closedById   Int?
  closeRemarks String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slaCategory     AssetSlaCategory?
  currentSlaLevel SlaLevel?

  // Governing SLA (stricter of internal vs vendor, used for breach tracking)
  slaExpectedValue Int?
  slaExpectedUnit  String? // HOURS | DAYS
  slaResolvedAt    DateTime?
  slaBreached      Boolean?

  // SLA source tracking
  slaSource String? // INTERNAL | VENDOR | BOTH

  // Internal SLA (from AssetSlaMatrix by category + priority)
  internalSlaValue Int?
  internalSlaUnit  String?

  // Vendor SLA (from active AMC/CMC contract)
  vendorSlaValue    Int?
  vendorSlaUnit     String?
  vendorSlaBreached Boolean?

  // Asset collection by supervisor (for external service center cases)
  collectionNotes           String?   @db.Text // notes by the ticket raiser on supervisor collecting the asset
  collectedAt               DateTime?
  collectedById             Int?
  collectedBy               Employee? @relation("TicketCollectedBy", fields: [collectedById], references: [id])
  collectionHandoverRemarks String?   @db.Text

  // Ticket work category (PM vs Breakdown — determines asset status flow)
  workCategory String? // PREVENTIVE_MAINTENANCE | BREAKDOWN | CORRECTIVE | CALIBRATION

  // Downtime (useful for hospital ops + finance reporting)
  downtimeStart DateTime?
  downtimeEnd   DateTime?

  // Cost capture (so finance excel is possible without a ledger module)
  serviceType String? // WARRANTY | AMC | CMC | PAID | INTERNAL
  serviceCost Decimal? @db.Decimal(12, 2)
  partsCost   Decimal? @db.Decimal(12, 2)
  totalCost   Decimal? @db.Decimal(12, 2)

  // Resolution knowledge
  rootCause            String?   @db.Text
  resolutionSummary    String?   @db.Text
  customerSatisfaction Int? // 1-5 feedback rating
  followUpDate         DateTime?

  // Closure / approvals (who/why)
  approvedBy     String?
  closedBy       String?
  closureRemarks String?

  createdById   Int?
  updatedById   Int?
  statusHistory TicketStatusHistory[]

  sparePartUsages SparePartUsage[]

  notifications             Notification[]
  ticketEscalations         TicketEscalation[]
  ticketAssignmentHistories TicketAssignmentHistory[]
  maintenanceHistories      MaintenanceHistory[]
  ticketTransferHistories   TicketTransferHistory[]
  rootCauseAnalyses         RootCauseAnalysis[]
  materialRequests          MaterialRequest[]
  workOrders                WorkOrder[]               @relation("TicketWorkOrders")

  serviceInvoices ServiceInvoice[]
  gatePasses      GatePass[]

  @@index([assetId, createdAt])
  @@index([departmentId, status])
  @@map("ticket")
}

model TicketAssignmentHistory {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  fromEmployeeId Int?
  fromEmployee   Employee? @relation("TicketAssignFrom", fields: [fromEmployeeId], references: [id])

  toEmployeeId Int?
  toEmployee   Employee? @relation("TicketAssignTo", fields: [toEmployeeId], references: [id])

  action  TicketAssignmentAction
  comment String                 @db.Text // ✅ mandatory on every assign/reassign

  performedById Int?
  performedBy   Employee? @relation("TicketAssignPerformedBy", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticketassignmenthistory")
}

model MaintenanceHistory {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  serviceContractId Int?
  serviceContract   ServiceContract? @relation(fields: [serviceContractId], references: [id])

  // Links a completed PM back to the schedule that triggered it (null for ad-hoc/contract work).
  maintenanceScheduleId Int?
  maintenanceSchedule   MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id])

  scheduledDue          DateTime
  actualDoneAt          DateTime?
  wasLate               Boolean
  performedBy           String
  // Who performed the service
  performedByType       String? // INTERNAL | VENDOR | EXTERNAL_SERVICE
  vendorId              Int?
  vendor                Vendor?   @relation(fields: [vendorId], references: [id])
  externalServiceCenter String? // free-text name when no vendor master record
  notes                 String?
  serviceReport         String?
  // Cost capture for finance excel
  serviceType           String? // WARRANTY | AMC | CMC | PAID | INTERNAL
  serviceCost           Decimal?  @db.Decimal(12, 2)
  partsCost             Decimal?  @db.Decimal(12, 2)
  totalCost             Decimal?  @db.Decimal(12, 2)

  createdById Int?
  updatedById Int?

  ticketId Int?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  preventiveChecklistRuns PreventiveChecklistRun[]

  pmChecklistRuns PMChecklistRun[]

  @@index([assetId, actualDoneAt])
  @@map("maintenancehistory")
}

model User {
  id         Int      @id @default(autoincrement())
  employeeID String   @unique
  employee   Employee @relation(fields: [employeeID], references: [employeeID])

  username     String    @unique
  passwordHash String
  role         String
  lastLogin    DateTime?

  // Single active web session per user. Stamped on login and re-issued on every
  // access token; a login elsewhere overwrites it, so the previous session's
  // next request carries a stale stamp and is rejected by authMiddleware. Null =
  // no active session yet (or a token issued before this feature) → allowed, so
  // enabling this never mass-logs-out anyone. Mobile app auth is separate and
  // unaffected.
  activeSessionId String?

  loginHistory  LoginHistory[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@map("users")
}

// Server-side refresh tokens for the web auth flow. Only the SHA-256 hash of the
// token is stored (never the raw value), so a DB leak can't be used to mint
// sessions. Rotated on every /refresh; revoked on logout or reuse.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refreshtoken")
}

// Per-department asset-table column layout. One config per department, but the
// uniqueness is enforced in the controller (findFirst → update/create) rather
// than a DB constraint, so the model can evolve without a migration headache.
// `columns` is an ordered JSON array of column keys from the server catalog.
model DepartmentColumnConfig {
  id           Int      @id @default(autoincrement())
  departmentId Int
  columns      Json
  updatedById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([departmentId])
  @@map("departmentcolumnconfig")
}

model LoginHistory {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  attemptedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("loginhistory")
}

model AssetCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String? @unique
  description String?
  isActive    Boolean @default(true)

  // Whether assets in this category must have a serial number.
  // Set false for non-serialized items (Office Equipment, Furniture, Stationery, etc.)
  serialRequired Boolean @default(true)

  // Drives which placement fields the Location tab shows for assets of this category.
  // ROOM (default) | NETWORK | CAMERA | OUTDOOR | GENERIC
  locationProfile String? @default("ROOM")

  // Default depreciation config — auto-applied to imported / new assets when not specified
  defaultDepreciationMethod     String? // "SL" | "DB"
  defaultDepreciationRate       Decimal?                       @db.Decimal(5, 2) // e.g. 15.00 for 15%
  defaultLifeYears              Int? // useful life in years (mainly for SL)
  assets                        Asset[]
  createdById                   Int?
  updatedById                   Int?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  escalationMatrixes            EscalationMatrix[]
  preventiveChecklistTemplates  PreventiveChecklistTemplate[]
  acknowledgementTemplates      AssetAcknowledgementTemplate[]
  pmChecklistTemplates          PMChecklistTemplate[]
  calibrationChecklistTemplates CalibrationChecklistTemplate[]
  supportMatrixes               AssetSupportMatrix[]
  assetSlaMatrices              AssetSlaMatrix[]
  assetIndents                  AssetIndent[]
  decisionEngineConfigs         DecisionEngineConfig[]         @relation("DecisionEngineCategory")
  depreciationRules             CategoryDepreciationRule[]
  assetDeptConfigs              AssetDepartmentConfig[]
  indentLines                   AssetIndentLine[]              @relation("IndentLineCategory")
  glMapping                     AssetGLMapping?
  capexBudgets                  CapexBudget[]                  @relation("CapexBudgetCat")
  assetPools                    AssetPool[]
  approvedVendors               ApprovedVendor[]               @relation("ApprovedVendorCategory")
  rateContractLines             RateContractLine[]             @relation("RateContractCategory")
  items                         AssetItem[]

  @@map("assetcategory")
}

// Item master — the approved list of things that can be captured as an asset or
// requested on an indent ("Dell Latitude 5420", "Infusion Pump"). The asset form
// and indent form pick from here instead of free-typing a name, which is what
// caused the same item to exist as several spellings.
//
// Only ADMIN/FINANCE maintain it (see item-master.routes.ts). Asset.assetName and
// AssetIndent.assetName stay plain strings — this master feeds them rather than
// replacing them, so nothing downstream has to change.
model AssetItem {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Mirror the asset form's own fields, so picking an item fills them in.
  nature AssetNature @default(TANGIBLE)
  type   String? // FIXED | MOVABLE — only meaningful for TANGIBLE items

  assetCategoryId Int
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([assetCategoryId])
  @@map("assetitem")
}

// Flat, global sub-type master (e.g. "Desktop Monitor", "Infusion Pump").
// Not tied to a category — selected in the asset Specification section and used
// to route repair tickets to the engineer configured per department.
model AssetSubType {
  id          Int     @id @default(autoincrement())
  // Name/code are globally unique (a name can't repeat across departments).
  name        String  @unique
  code        String? @unique
  description String?
  isActive    Boolean @default(true)

  // Owning department — a HOD only manages/sees sub-types for their department.
  departmentId Int?
  department   Department? @relation("DeptSubTypes", fields: [departmentId], references: [id])

  assets         Asset[]
  supportConfigs SubTypeSupportConfig[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([departmentId])
  @@map("assetsubtype")
}

// HOD-configured mapping: which repair engineer handles a given sub-type in a
// given department. One primary engineer per (subType, department). Ticket
// auto-assign resolves the asset's sub-type + department to this engineer,
// falling back to the department supervisor when no config exists.
model SubTypeSupportConfig {
  id Int @id @default(autoincrement())

  assetSubTypeId Int
  assetSubType   AssetSubType @relation(fields: [assetSubTypeId], references: [id])

  departmentId Int
  department   Department @relation("SubTypeSupportDept", fields: [departmentId], references: [id])

  employeeId Int
  employee   Employee @relation("SubTypeSupportEngineer", fields: [employeeId], references: [id])

  isPrimary Boolean @default(true)
  isActive  Boolean @default(true)
  notes     String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([assetSubTypeId, departmentId])
  @@index([departmentId])
  @@map("subtypesupportconfig")
}

model Department {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  code                  String?                 @unique // Short code like ICU, OT, RADIOLOGY
  parentDepartmentId    Int?
  parentDepartment      Department?             @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments      Department[]            @relation("DeptHierarchy")
  isActive              Boolean                 @default(true)
  // Which department-dashboard widget set this department sees. Admin-assigned.
  // STORES | PURCHASE | IT | MAINTENANCE | BIOMEDICAL | GENERIC (null → GENERIC)
  dashboardProfile      String?
  assets                Asset[]
  tickets               Ticket[]                @relation("TicketDepartment")
  employees             Employee[]
  createdById           Int?
  updatedById           Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  escalationMatrixes    EscalationMatrix[]
  targetAssets          Asset[]                 @relation("TargetDept")
  ownedTickets          Ticket[]                @relation("TicketOwningDept")
  transferFrom          TicketTransferHistory[] @relation("TicketTransferFromDept")
  transferTo            TicketTransferHistory[] @relation("TicketTransferToDept")
  assetTransferFrom     AssetTransferHistory[]  @relation("AssetTransferFromDept")
  assetTransferTo       AssetTransferHistory[]  @relation("AssetTransferToDept")
  assetIndents          AssetIndent[]
  purchaseOrders        PurchaseOrder[]         @relation("PODepartment")
  financeVouchers       FinanceVoucher[]        @relation("VoucherDept")
  voucherLines          FinanceVoucherLine[]    @relation("FVLineCostCentre")
  capexBudgets          CapexBudget[]           @relation("CapexBudgetDept")
  assetDeptConfigs      AssetDepartmentConfig[] @relation("AssetDeptConfig")
  placements            PlacementAgreement[]    @relation("DepartmentPlacements")
  condemnationCommittees CondemnationCommittee[] @relation("CommitteeDepartment")
  assetPools            AssetPool[]             @relation("AssetPoolDepartment")
  subTypeSupportConfigs SubTypeSupportConfig[]  @relation("SubTypeSupportDept")
  assetSubTypes         AssetSubType[]          @relation("DeptSubTypes")

  // Vendors that serve this department (M2M inverse).
  vendors Vendor[] @relation("VendorDepartments")

  storeTransfersIn StoreTransfer[] @relation("TransferToDepartment")

  gatePassesToApprove GatePass[] @relation("GatePassApproverDept")
  gatePassesProcess   GatePass[] @relation("GatePassProcessDept")

  @@map("department")
}

model Employee {
  id               Int             @id @default(autoincrement())
  name             String
  employeeID       String          @unique
  email            String?
  phone            String?
  designation      String?
  departmentId     Int?
  department       Department?     @relation(fields: [departmentId], references: [id])
  reportingToId    Int?
  reportingTo      Employee?       @relation("EmployeeReporting", fields: [reportingToId], references: [id])
  directReports    Employee[]      @relation("EmployeeReporting")
  isActive         Boolean         @default(true)
  // Contract / agency staff (e.g. outsourced security) rather than payroll.
  // They need Employee rows because User.employeeID FKs to this table, so a
  // login can't exist without one — this flag is what keeps them out of
  // headcount reporting. Their employeeID also carries an "OS-" prefix.
  //
  // Set at creation only: updateEmployee deliberately ignores it, because the
  // employeeID it pairs with is itself immutable (renaming would orphan the
  // User FK), so a later flip would leave the flag and the ID disagreeing.
  isOutsourced     Boolean         @default(false)
  assets           Asset[]
  user             User?
  role             EmployeeRole    @default(EXECUTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  AssetLocation    AssetLocation[]
  supervisedAssets Asset[]         @relation("AssetSupervisor")
  allocatedAssets  Asset[]         @relation("AssetEndUser")
  qrStickeredAssets Asset[]        @relation("AssetQrStickeredBy")

  qrScans       QRScanLog[]
  assetScanLogs AssetScanLog[]

  notificationsCreated Notification[] @relation("NotificationCreatedBy")
  notificationsLinked  Notification[] @relation("NotificationEmployee")

  assignedAssets              AssetAssignment[]    @relation("AssignedTo")
  assignedByAssets            AssetAssignment[]    @relation("AssignedBy")
  calibrationHistoriesCreated CalibrationHistory[] @relation("EmployeeCreatedCalibrationHistory")

  notificationRecipients   NotificationRecipient[]
  depreciationLogs         DepreciationLog[]
  sparePartUsages          SparePartUsage[]
  inventoryTransactions    InventoryTransaction[]
  documents                Document[]
  assetAssignments         AssetAssignment[]
  assetAssignmentHistories AssetAssignmentHistory[]
  escalationMatrixes       EscalationMatrix[]
  ticketEscalations        TicketEscalation[]
  preventiveChecklistRuns  PreventiveChecklistRun[]
  // Ticket reverse relations
  raisedTickets            Ticket[]                 @relation("TicketRaisedBy")
  assignedTickets          Ticket[]                 @relation("TicketAssignedTo")
  assignedByMe             Ticket[]                 @relation("TicketAssignedBy")

  // History reverse relations
  ticketAssignedFrom      TicketAssignmentHistory[] @relation("TicketAssignFrom")
  ticketAssignedTo        TicketAssignmentHistory[] @relation("TicketAssignTo")
  ticketAssignActions     TicketAssignmentHistory[] @relation("TicketAssignPerformedBy")
  ticketStatusChanges     TicketStatusHistory[]     @relation("TicketStatusChangedBy")
  ticketTransferRequested TicketTransferHistory[]   @relation("TicketTransferRequestedBy")
  ticketTransferApproved  TicketTransferHistory[]   @relation("TicketTransferApprovedBy")

  assetAcknowledgementRuns AssetAcknowledgementRun[]
  assetSupportMatrixes     AssetSupportMatrix[]
  subTypeSupportConfigs    SubTypeSupportConfig[]    @relation("SubTypeSupportEngineer")
  supervisedAssetLinks     AssetSupervisor[]         @relation("EmployeeSupervisedAssets")
  transferRequests         AssetTransferHistory[]    @relation("TransferRequestedBy")
  transferApprovals        AssetTransferHistory[]    @relation("TransferApprovedBy")
  transferMgmtApprovals    AssetTransferHistory[]    @relation("TransferMgmtApprovedBy")
  locationRequests         AssetLocation[]           @relation("LocationRequestedBy")
  locationApprovals        AssetLocation[]           @relation("LocationApprovedBy")
  locationRejections       AssetLocation[]           @relation("LocationRejectedBy")
  modulePermissions        ModulePermission[]
  notificationPreference   NotificationPreference?

  collectedTickets            Ticket[]              @relation("TicketCollectedBy")
  gatePassesApproved          GatePass[]            @relation("GatePassApprover")
  gatePassesRequested         GatePass[]            @relation("GatePassRequester")
  gatePassesGatedOut          GatePass[]            @relation("GatePassSecurityOut")
  gatePassesGatedIn           GatePass[]            @relation("GatePassSecurityIn")
  gatePassLabelsPrinted       GatePass[]            @relation("GatePassLabelPrinter")
  gatePassesCarried           GatePass[]            @relation("GatePassCarriedBy")
  gatePassesOpsApproved       GatePass[]            @relation("GatePassOpsApprover")
  gatePassesSecurityCleared   GatePass[]            @relation("GatePassSecurityCleared")
  assetIndents                AssetIndent[]         @relation("IndentRaisedBy")
  assetIndentApprovals        AssetIndent[]         @relation("IndentApprovedBy")
  employeeExits               EmployeeExit[]        @relation("ExitEmployee")
  employeeExitHandledBy       EmployeeExit[]        @relation("ExitHandledBy")
  serviceVisitsAsEngineer     ServiceVisit[]        @relation("ServiceVisitEngineer")
  serviceVisitChargeApprovals ServiceVisit[]        @relation("ServiceVisitChargeApprover")
  serviceVisitsCreated        ServiceVisit[]        @relation("ServiceVisitCreatedBy")
  subAssetReplacements        SubAssetReplacement[]
  decisionEvaluations         DecisionEngineLog[]   @relation("DecisionEvaluator")
  usageLogsRecorded           AssetDailyUsageLog[]  @relation("UsageLoggedBy")
  pvApprovals                 PurchaseVoucher[]     @relation("PVApprovedBy")
  pvCreated                   PurchaseVoucher[]     @relation("PVCreatedBy")
  pmtApprovals                PaymentVoucher[]      @relation("PMTApprovedBy")
  pmtCreated                  PaymentVoucher[]      @relation("PMTCreatedBy")
  jeCreated                   JournalEntry[]        @relation("JECreatedBy")

  batchDepreciationRuns      BatchDepreciationRun[] @relation("BatchRunBy")
  delegationsGiven           ApprovalDelegation[]   @relation("DelegationFrom")
  delegationsReceived        ApprovalDelegation[]   @relation("DelegationTo")
  tdsDeductionsCreated       TdsDeduction[]         @relation("TdsDeductionCreatedBy")
  tdsChallansCreated         TdsChallan[]           @relation("TdsChallanCreatedBy")
  coverRenewalsDecided       CoverRenewal[]         @relation("CoverRenewalDecidedBy")
  uptimeAssessed             UptimeAssessment[]     @relation("UptimeAssessedBy")
  uptimeWaived               UptimeAssessment[]     @relation("UptimeWaivedBy")
  ldWaived                   LiquidatedDamage[]     @relation("LdWaivedBy")
  gstDocumentsCreated        GstDocument[]          @relation("GstDocumentCreatedBy")
  gstPeriodsPrepared         GstPeriodSummary[]     @relation("GstPeriodPreparedBy")
  placementsCreated          PlacementAgreement[]   @relation("PlacementCreatedBy")
  placementConsumptions      PlacementConsumption[] @relation("PlacementConsumptionBy")
  committeeMemberships       CondemnationCommitteeMember[] @relation("CommitteeMemberships")
  inspectionsConvened        CondemnationInspection[]     @relation("InspectionConvenedBy")
  condemnationVotes          CondemnationVote[]           @relation("CondemnationVotes")
  sanitisationsPerformed     DataSanitisation[]           @relation("SanitisationPerformedBy")
  sanitisationsVerified      DataSanitisation[]           @relation("SanitisationVerifiedBy")
  budgetMovementsRequested   BudgetMovement[]             @relation("MovementRequestedBy")
  budgetMovementsApproved    BudgetMovement[]             @relation("MovementApprovedBy")
  gstr2bImports              Gstr2bImport[]               @relation("Gstr2bImportedBy")
  batchDepreciationApprovals BatchDepreciationRun[] @relation("BatchApprovedBy")

  depreciationAuditsFinance DepreciationAudit[] @relation("DepAuditFinanceApprovedBy")
  depreciationAuditsCfo     DepreciationAudit[] @relation("DepAuditCfoApprovedBy")

  // Finance Engine relations
  financeConfigUpdates    FinanceConfig[]                 @relation("FinanceConfigUpdatedBy")
  financeVouchersCreated  FinanceVoucher[]                @relation("FVCreatedBy")
  financeVouchersApproved FinanceVoucher[]                @relation("FVApprovedBy")
  exportBatchesCreated    ExportBatch[]                   @relation("ExportBatchCreatedBy")
  capexBudgetsCreated     CapexBudget[]                   @relation("CapexBudgetCreatedBy")
  manualLedgerEntries     ManualLedgerEntry[]             @relation("MLECreatedBy")
  assetPoolsCreated       AssetPool[]                     @relation("AssetPoolCreatedBy")
  assetPoolAdjustments    AssetPoolAdjustment[]           @relation("AssetPoolAdjCreatedBy")
  assetPoolDepSchedules   AssetPoolDepreciationSchedule[] @relation("AssetPoolDepSchedCreatedBy")
  eWasteHodSigns          EWasteRecord[]                  @relation("EWasteHodSign")
  eWasteOpsSigns          EWasteRecord[]                  @relation("EWasteOpsSign")
  eWasteSecSigns          EWasteRecord[]                  @relation("EWasteSecSign")
  eWasteCreated           EWasteRecord[]                  @relation("EWasteCreatedBy")
  serviceInvoicesCreated  ServiceInvoice[]                @relation("ServiceInvoiceCreatedBy")
  serviceInvoicesApproved ServiceInvoice[]                @relation("ServiceInvoiceApprovedBy")
  reconciliationsCreated  ReconciliationSnapshot[]        @relation("ReconCreatedBy")
  reconciliationsResolved ReconciliationSnapshot[]        @relation("ReconResolvedBy")
  deviceTokens            DeviceToken[]

  @@map("employee")
}

model Vendor {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  contact        String
  email          String?
  contactPerson  String?
  alternatePhone String?
  address        String?  @db.Text
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?
  panNumber      String?
  vendorType     String? // OEM | DISTRIBUTOR | SERVICE_PROVIDER | RESELLER
  rating         Int? // 1-5 performance rating
  isActive       Boolean  @default(true)
  bankName       String?
  bankAccount    String?
  bankIfsc       String?
  assets         Asset[]
  createdById    Int?
  updatedById    Int?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  serviceContracts     ServiceContract[]
  spareParts           SparePart[]
  maintenanceHistories MaintenanceHistory[]

  calibrationSchedules    CalibrationSchedule[]   @relation("VendorCalibrationSchedule")
  calibrationHistories    CalibrationHistory[]    @relation("VendorCalibrationHistory")
  ticketTransferHistories TicketTransferHistory[]
  warranties              Warranty[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  purchaseVouchers        PurchaseVoucher[]       @relation("VendorPurchaseVouchers")
  paymentVouchers         PaymentVoucher[]        @relation("VendorPaymentVouchers")
  serviceInvoices         ServiceInvoice[]        @relation("ServiceInvoiceVendor")
  externalPurchaseOrders  ExternalPurchaseOrder[]
  libraryItems            LibraryItem[]           @relation("LibraryVendor")
  quotations              PurchaseQuotation[]     @relation("QuotationVendor")

  // Departments this vendor serves. Drives department-scoped vendor performance.
  departments Department[] @relation("VendorDepartments")

  // ── Withholding tax profile ──────────────────────────────────────────────
  // Rate depends on more than the section: no PAN means 20%, a lower-deduction
  // certificate overrides downward, and a non-filer under 206AB pays higher.
  panVerified          Boolean   @default(false)
  deducteeStatus       String? // COMPANY | FIRM | INDIVIDUAL | HUF | AOP | TRUST | LLP
  defaultTdsSectionId  Int?
  defaultTdsSection    TdsSection? @relation("VendorDefaultSection", fields: [defaultTdsSectionId], references: [id])
  ldcNumber            String? // lower deduction certificate u/s 197
  ldcRate              Decimal?  @db.Decimal(6, 3)
  ldcValidFrom         DateTime?
  ldcValidTo           DateTime?
  ldcThreshold         Decimal?  @db.Decimal(14, 2) // certificate is capped at an amount
  isNonFiler206AB      Boolean   @default(false)
  tdsExempt            Boolean   @default(false)
  tdsExemptReason      String?   @db.Text
  // 206C(1H): a seller who already collects TCS means the buyer must not also
  // deduct under 194Q on the same transaction.
  collectsTcs194Q      Boolean   @default(false)

  tdsDeductions TdsDeduction[] @relation("VendorTdsDeductions")
  gstDocuments  GstDocument[]  @relation("VendorGstDocuments")
  placements    PlacementAgreement[] @relation("VendorPlacements")
  goodsReturns  GoodsReturn[]
  rateContracts RateContract[]
  approvals     ApprovedVendor[]

  @@map("vendor")
}

// Withholding sections as the tenant configures them — rates change every
// Finance Act, so they are data, not code.
model TdsSection {
  id          Int     @id @default(autoincrement())
  code        String // 194C | 194J | 194I | 194Q | 206C(1H) ...
  name        String
  description String? @db.Text

  /// TCS is collected from the customer, TDS deducted from the vendor. Same
  /// machinery, opposite direction.
  isTcs Boolean @default(false)

  rate           Decimal @db.Decimal(6, 3)
  rateWithoutPan Decimal @db.Decimal(6, 3) @default(20)

  /// Deduct only on the excess over this, not on the whole amount (194Q).
  deductOnExcessOverThreshold Boolean @default(false)

  singleTxnThreshold  Decimal? @db.Decimal(14, 2)
  annualThreshold     Decimal? @db.Decimal(14, 2)

  /// Which asset categories or spend this section is normally used for.
  appliesTo String? @db.Text

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  deductions     TdsDeduction[]
  defaultVendors Vendor[]       @relation("VendorDefaultSection")

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([code, effectiveFrom])
  @@map("tdssection")
}

// One deduction, tied to the payment that carried it.
model TdsDeduction {
  id String @id @default(uuid())

  vendorId Int
  vendor   Vendor @relation("VendorTdsDeductions", fields: [vendorId], references: [id])

  sectionId Int
  section   TdsSection @relation(fields: [sectionId], references: [id])

  paymentVoucherId Int?
  paymentVoucher   PaymentVoucher? @relation("PaymentTdsDeductions", fields: [paymentVoucherId], references: [id])

  purchaseVoucherId Int?

  /// Gross bill, the part actually exposed to the section, and what came off.
  grossAmount   Decimal @db.Decimal(14, 2)
  taxableAmount Decimal @db.Decimal(14, 2)
  rateApplied   Decimal @db.Decimal(6, 3)
  tdsAmount     Decimal @db.Decimal(14, 2)
  netPaid       Decimal @db.Decimal(14, 2)

  /// Why this rate and not the section's headline rate.
  rateReason String? @db.Text

  deductionDate DateTime
  fiscalYear    Int
  quarter       String // Q1 | Q2 | Q3 | Q4

  status String @default("DEDUCTED") // DEDUCTED | DEPOSITED | RETURN_FILED | CERTIFICATE_ISSUED

  challanId String?
  challan   TdsChallan? @relation(fields: [challanId], references: [id])

  certificateNo     String? // Form 16A
  certificateIssued DateTime?

  createdById Int?
  createdBy   Employee? @relation("TdsDeductionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([vendorId, fiscalYear])
  @@index([fiscalYear, quarter])
  @@map("tdsdeduction")
}

// The challan the deductions were remitted under. Until deductions carry one,
// the money is deducted but not paid over — which is where the interest is.
model TdsChallan {
  id String @id @default(uuid())

  challanNo   String
  bsrCode     String?
  depositDate DateTime
  amount      Decimal  @db.Decimal(14, 2)

  interest Decimal? @db.Decimal(14, 2)
  fee      Decimal? @db.Decimal(14, 2) // 234E late filing fee

  fiscalYear Int
  quarter    String
  sectionCode String?

  bankName      String?
  paymentMode   String? // ONLINE | CHEQUE
  acknowledgeNo String?

  returnFiled     Boolean   @default(false)
  returnFiledDate DateTime?
  returnAckNo     String?

  notes String? @db.Text

  deductions TdsDeduction[]

  createdById Int?
  createdBy   Employee? @relation("TdsChallanCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([fiscalYear, quarter])
  @@map("tdschallan")
}

model TicketStatusHistory {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket       @relation(fields: [ticketId], references: [id])
  status    TicketStatus
  changedAt DateTime     @default(now())
  changedBy String

  note String? @db.Text

  changedById       Int?
  changedByEmployee Employee? @relation("TicketStatusChangedBy", fields: [changedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("ticketstatushistory")
}

model AssetDepreciation {
  id      Int   @id @default(autoincrement())
  assetId Int   @unique
  asset   Asset @relation(fields: [assetId], references: [id])

  depreciationMethod String // SL | DB | OTHER
  depreciationRate   Decimal   @db.Decimal(12, 2)
  expectedLifeYears  Int
  salvageValue       Decimal?  @db.Decimal(12, 2)
  depreciationStart  DateTime
  lastCalculatedAt   DateTime?

  // Added for finance reporting
  accumulatedDepreciation Decimal? @db.Decimal(12, 2)
  currentBookValue        Decimal? @db.Decimal(12, 2)
  depreciationFrequency   String? // MONTHLY | YEARLY
  isActive                Boolean? @default(true)

  // Round-off settings (per-asset, applies only to depreciation amounts)
  roundOff      Boolean @default(false)
  decimalPlaces Int     @default(2) // 0 = nearest rupee, 2 = paise

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("assetdepreciation")
}

model DepreciationLog {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  // Which set of books this entry belongs to. Existing rows are all tax-book
  // entries, which is why it defaults that way.
  book DepreciationBook @default(TAX)

  periodStart        DateTime
  periodEnd          DateTime
  depreciationAmount Decimal  @db.Decimal(12, 2)
  bookValueAfter     Decimal  @db.Decimal(12, 2)

  // ── Split-method breakdown (Indian IT Act compliant) ────────────────────
  fyLabel          String? // e.g. "FY2024-25"
  openingWdv       Decimal? @db.Decimal(14, 2) // WDV at start of this period (= prior closing)
  depOnOpening     Decimal? @db.Decimal(14, 2) // dep computed on opening WDV @ full rate
  depOnAdditions   Decimal? @db.Decimal(14, 2) // dep on additions in this FY (full or half rate)
  additionsAmount  Decimal? @db.Decimal(14, 2) // gross additions in this FY (per asset = its cost in Y1)
  effectiveRate    Decimal? @db.Decimal(8, 4) // final % rate applied (after half-year adjust)
  halfYearApplied  Boolean? @default(false) // true if 50% rule used
  isFirstFY        Boolean? @default(false) // true if this is the asset's first FY of dep
  openingWdvSource String? // PRIOR_LOG | PURCHASE_COST | MIGRATION

  doneById Int?
  doneBy   Employee? @relation(fields: [doneById], references: [id])

  reason     String?
  batchRunId Int?
  batchRun   BatchDepreciationRun? @relation(fields: [batchRunId], references: [id])

  createdAt DateTime @default(now())

  @@index([assetId, periodEnd])
  @@map("depreciationlog")
}

// ── Batch Depreciation Run ─────────────────────────────────────────────────
// Each run starts as DRAFT, CFO approves → APPROVED (values committed), or REJECTED
model BatchDepreciationRun {
  id          Int     @id @default(autoincrement())
  runNumber   String  @unique // BDR-2025-001
  status      String  @default("DRAFT") // DRAFT | APPROVED | REJECTED
  fiscalYear  Int // e.g. 2025 = FY 2025-26
  periodLabel String? // e.g. "FY 2025-26 Q1"

  // Runs are per book — a company closes its Companies Act year and its tax
  // year with different numbers, from separate runs.
  book DepreciationBook @default(TAX)

  totalAssets       Int     @default(0)
  totalDepreciation Decimal @default(0) @db.Decimal(14, 2)

  notes           String? @db.Text
  rejectionReason String? @db.Text

  runById Int
  runBy   Employee @relation("BatchRunBy", fields: [runById], references: [id])

  approvedById Int?
  approvedBy   Employee? @relation("BatchApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  logs            DepreciationLog[]
  financeVouchers FinanceVoucher[]  @relation("VoucherBatchRun")

  @@map("batchdepreciationrun")
}

// Per-financial-year depreciation audit sign-off.
// Flow: FINANCE (Finance HOD) creates → their creation IS their approval →
// status PENDING. Then CFO and the External CA each approve (parallel, both
// required). When both cfoApprovedAt and caApprovedAt are set → status AUDITED.
// Either approver may REJECT (with reason); FINANCE can revise and resubmit.
model DepreciationAudit {
  id         Int    @id @default(autoincrement())
  fiscalYear Int    @unique // e.g. 2025 = FY 2025-26 (FY start year)
  status     String @default("PENDING") // PENDING | AUDITED | REJECTED

  // Snapshot of the depreciation position at creation time (for the record).
  totalDepreciation Decimal @default(0) @db.Decimal(14, 2)
  assetCount        Int     @default(0)

  notes String? @db.Text

  // Finance HOD — creates and simultaneously approves.
  financeApprovedById Int
  financeApprovedBy   Employee @relation("DepAuditFinanceApprovedBy", fields: [financeApprovedById], references: [id])
  financeApprovedAt   DateTime @default(now())

  // CFO approval.
  cfoApprovedById Int?
  cfoApprovedBy   Employee? @relation("DepAuditCfoApprovedBy", fields: [cfoApprovedById], references: [id])
  cfoApprovedAt   DateTime?

  // External CA — identified by email (no Employee FK; separate auditor login).
  caApprovedByEmail String?
  caApprovedByName  String?
  caApprovedAt      DateTime?

  // Rejection (by CFO or CA).
  rejectedByRole  String? // CFO | CA
  rejectedByName  String?
  rejectionReason String?   @db.Text
  rejectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("depreciationaudit")
}

model AssetInsurance {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  provider       String?
  policyNumber   String?
  coverageAmount Decimal?  @db.Decimal(12, 2)
  premiumAmount  Decimal?  @db.Decimal(12, 2)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)

  // Added fields for hospital finance
  policyType          String? // COMPREHENSIVE | FIRE | THEFT | DAMAGE | LIABILITY
  policyStatus        String? // ACTIVE | EXPIRED | CLAIMED | CANCELLED
  renewalReminderDays Int?    @default(30)

  document String?
  notes    String?

  claims        InsuranceClaim[]
  notifications Notification[]

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([assetId, endDate])
  @@map("assetinsurance")
}

model InsuranceClaim {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  insuranceId Int
  insurance   AssetInsurance @relation(fields: [insuranceId], references: [id])

  claimNumber    String
  claimDate      DateTime
  claimAmount    Decimal  @db.Decimal(12, 2)
  approvedAmount Decimal? @db.Decimal(12, 2)
  claimStatus    String? // SUBMITTED | IN_PROGRESS | APPROVED | REJECTED | SETTLED

  reason    String?
  claimedBy String?
  documents String?
  settledAt DateTime?

  notifications Notification[]

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([insuranceId, claimNumber])
  @@map("insuranceclaim")
}

model Branch {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  code     String? @unique
  address  String? @db.Text
  city     String?
  state    String?
  pincode  String?
  phone    String?
  isActive Boolean @default(true)

  locations     AssetLocation[]
  transfersFrom AssetTransferHistory[] @relation("FromBranch")
  transfersTo   AssetTransferHistory[] @relation("ToBranch")
  floorPlans    FloorPlan[]
  currentAssets Asset[]                @relation("AssetCurrentBranch")
  assetIndents  AssetIndent[]          @relation("IndentBranch")

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("branch")
}

model AssetLocation {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  block              String?
  floor              String?
  room               String?
  departmentSnapshot String?

  // ── Precise placement (Phase 1) — beyond Block/Floor/Room ──
  // Lets non-room assets (cameras, network gear, outdoor infra) record where
  // they actually sit. All optional; existing room-based assets are unaffected.
  // Per-asset profile chosen on the Location tab (overrides the category default).
  placementProfile String? // ROOM | CAMERA | NETWORK | OUTDOOR | GENERIC
  placementType    String? // ROOM | RACK | MOUNTED | AREA | OUTDOOR
  placementLabel   String?  @db.Text // free text, e.g. "Above main entrance, facing reception"
  mountType        String? // WALL | CEILING | POLE | DESK | RACK | FLOOR
  rackCode         String? // network gear: rack identifier
  rackUnit         String? // network gear: U-position, e.g. "U23"
  portRef          String? // network gear: panel/port reference
  coverageArea     String?  @db.Text // cameras/sensors: area covered
  latitude         Decimal? @db.Decimal(10, 7) // outdoor / GPS-tagged assets
  longitude        Decimal? @db.Decimal(10, 7)

  // ── Floor-plan pin (Phase 3) — position on an uploaded floor-plan image ──
  floorPlanId Int?
  floorPlan   FloorPlan? @relation(fields: [floorPlanId], references: [id])
  planX       Float? // pin X as a 0–100 percentage of image width
  planY       Float? // pin Y as a 0–100 percentage of image height

  employeeResponsibleId Int?
  employeeResponsible   Employee? @relation(fields: [employeeResponsibleId], references: [id])

  isActive      Boolean @default(true)
  status        String  @default("REQUESTED") // REQUESTED | APPROVED | REJECTED
  // Which approver tier must sign off a pending change: HOD | MANAGEMENT.
  // Set from the requester's role at request time. Null on auto-approved rows.
  approvalLevel String?

  requestedById Int?
  requestedBy   Employee? @relation("LocationRequestedBy", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   Employee? @relation("LocationApprovedBy", fields: [approvedById], references: [id])

  rejectedById Int?
  rejectedBy   Employee? @relation("LocationRejectedBy", fields: [rejectedById], references: [id])

  requestReason   String?
  approvalReason  String?
  rejectionReason String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdById Int?
  updatedById Int?

  createdAt DateTime @default(now())

  @@index([assetId, isActive])
  @@index([floorPlanId])
  @@map("assetlocation")
}

// ── Floor-plan images (Phase 3) — one per branch/block/floor ──
// Assets are pinned onto these via AssetLocation.floorPlanId + planX/planY.
model FloorPlan {
  id       Int     @id @default(autoincrement())
  name     String
  branchId Int
  branch   Branch  @relation(fields: [branchId], references: [id])
  block    String?
  floor    String?

  imageUrl String // served from /uploads/floor-plans/...
  width    Int? // natural image width (px) — optional, for scaling
  height   Int?

  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  locations AssetLocation[]
  zones     FloorPlanZone[]

  @@index([branchId])
  @@map("floorplan")
}

// A room / area outline traced once on a floor-plan image. Turns the plan from a
// bag of points into addressable spaces: filter to one room, zoom to it, colour
// it by asset count or audit progress. Which assets sit in a zone is derived by
// point-in-polygon against AssetLocation.planX/planY at read time, so pins and
// zones can never drift out of sync.
model FloorPlanZone {
  id          Int       @id @default(autoincrement())
  floorPlanId Int
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  name       String
  roomNumber String? // the hospital's own room number, e.g. "1521"
  department String? // department that occupies it, when it is a fixed one
  kind       String  @default("ROOM") // ROOM | CORRIDOR | WARD | OT | UTILITY | OUTDOOR

  // Outline as [[x, y], …] with x/y as 0–100 percentages of the image, the same
  // space AssetLocation.planX/planY uses.
  polygon Json

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([floorPlanId])
  @@map("floorplanzone")
}

model AssetTransferHistory {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  transferType String // INTERNAL | EXTERNAL

  // INTERNAL DETAILS
  block String?
  floor String?
  room  String?

  // EXTERNAL DETAILS
  externalType String? // BRANCH | SERVICE | DEAD

  // FROM branch (nullable for first move)
  fromBranchId Int?
  fromBranch   Branch? @relation("FromBranch", fields: [fromBranchId], references: [id])

  // TO branch (required)
  toBranchId Int?
  toBranch   Branch? @relation("ToBranch", fields: [toBranchId], references: [id])

  // Department-level transfer tracking
  fromDepartmentId Int?
  fromDepartment   Department? @relation("AssetTransferFromDept", fields: [fromDepartmentId], references: [id])
  toDepartmentId   Int?
  toDepartment     Department? @relation("AssetTransferToDept", fields: [toDepartmentId], references: [id])

  destinationType          String? // BRANCH | VENDOR | SERVICE_CENTER | EVENT | CAMP | PATIENT_HOME | OTHER
  destinationName          String?
  destinationAddress       String?
  destinationContactPerson String?
  destinationContactNumber String?

  temporary Boolean   @default(false)
  expiresAt DateTime?

  transferDate DateTime? @default(now())

  status String @default("REQUESTED")

  // Management approval — required when temporary=false (permanent transfer)
  managementApprovalStatus String?
  managementApprovedById   Int?
  managementApprovedBy     Employee? @relation("TransferMgmtApprovedBy", fields: [managementApprovedById], references: [id])
  managementApprovedAt     DateTime?
  managementRemarks        String?   @db.Text

  requestedById Int?
  requestedBy   Employee? @relation("TransferRequestedBy", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   Employee? @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?
  returnedAt  DateTime?

  approvalReason  String? @db.Text
  rejectionReason String? @db.Text
  returnReason    String? @db.Text
  reason          String?

  parentTransferId Int?
  parentTransfer   AssetTransferHistory?  @relation("TransferParent", fields: [parentTransferId], references: [id])
  returnEntries    AssetTransferHistory[] @relation("TransferParent")

  createdAt                DateTime                  @default(now())
  assetAcknowledgementRuns AssetAcknowledgementRun[] @relation("TransferAcknowledgementRuns")
  gatePasses               GatePass[]

