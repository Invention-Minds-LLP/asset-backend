  asset   Asset @relation("ExitAssets", fields: [assetId], references: [id])

  status            String    @default("PENDING") // PENDING | RETURNED | TRANSFERRED | WRITTEN_OFF
  returnedAt        DateTime?
  conditionOnReturn String? // GOOD | DAMAGED | MISSING
  handoverToId      Int? // employee the asset is reassigned to
  remarks           String?   @db.Text

  createdAt DateTime @default(now())

  @@index([exitId, status])
  @@map("employeeexitasset")
}

// ═══════════════════════════════════════════════════════
// DECISION ENGINE — Configurable thresholds per category
// ═══════════════════════════════════════════════════════
model DecisionEngineConfig {
  id Int @id @default(autoincrement())

  // Scope — NULL means global default; set categoryId for per-category overrides
  categoryId Int?           @unique
  category   AssetCategory? @relation("DecisionEngineCategory", fields: [categoryId], references: [id])

  // Signal weights (must sum to 100)
  weightMaintenanceRatio Int @default(30)
  weightAgeFactor        Int @default(20)
  weightBreakdownFreq    Int @default(20)
  weightDowntimeImpact   Int @default(15)
  weightCostTrend        Int @default(15)

  // Decision thresholds (composite score ranges)
  thresholdMonitor Int @default(36) // score >= this → MONITOR
  thresholdReview  Int @default(56) // score >= this → REVIEW_FOR_REPLACEMENT
  thresholdReplace Int @default(76) // score >= this → REPLACE_IMMEDIATELY

  // Signal-specific tuning
  maintenanceRatioCeiling Float @default(1.5) // maintenance/bookValue ratio that maps to score 100
  breakdownHighPerYear    Int   @default(6) // breakdowns/year that maps to score 100
  downtimeHighHours       Int   @default(720) // hours/year downtime that maps to score 100
  costTrendHighPct        Float @default(50) // YoY cost increase % that maps to score 100

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("decision_engine_config")
}

// Decision engine evaluation log — stores each run result for auditing
model DecisionEngineLog {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation("DecisionLogs", fields: [assetId], references: [id])

  // Individual signal scores (0–100)
  scoreMaintenanceRatio Float
  scoreAgeFactor        Float
  scoreBreakdownFreq    Float
  scoreDowntimeImpact   Float
  scoreCostTrend        Float
  compositeScore        Float

  decision String // CONTINUE_MAINTENANCE | MONITOR | REVIEW_FOR_REPLACEMENT | REPLACE_IMMEDIATELY

  // Snapshot of key data at evaluation time
  maintenanceCost   Float
  bookValue         Float
  assetAgeYears     Float
  expectedLifeYears Float
  breakdownCount12m Int
  downtimeHours12m  Float
  costTrendPct      Float?

  reasons Json // string[] — human-readable reasons

  evaluatedAt   DateTime  @default(now())
  evaluatedById Int?
  evaluatedBy   Employee? @relation("DecisionEvaluator", fields: [evaluatedById], references: [id])

  @@index([assetId, evaluatedAt])
  @@map("decision_engine_log")
}

// ═══════════════════════════════════════════════════════
// TENANT CONFIG — Feature flags per client/tenant
// ═══════════════════════════════════════════════════════
model TenantConfig {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  value String
  label String?
  group String? // PROCUREMENT | STORE | WORKORDER | ANALYTICS | RCA | ACCOUNTS

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("tenantconfig")
}

// ═══════════════════════════════════════════════════════
// INSTITUTION PROFILE — who this deployment belongs to
// ═══════════════════════════════════════════════════════
// Two axes drive behaviour across the whole product:
//   sector       decides which registers and compliance rules exist
//   entityType   decides the accounting — which depreciation books are
//                produced, and whether the charitable double-deduction rule
//                applies at all
// Single row per deployment. Read constantly by the depreciation, tax and
// compliance engines, so it is a typed model rather than key-value strings.

enum InstitutionSector {
  HEALTHCARE
  EDUCATION
  GENERIC
}

enum LegalEntityType {
  TRUST // charitable trust or society — application-of-income rules apply
  SOCIETY
  SECTION_8 // not-for-profit company
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  LLP
  PARTNERSHIP
  PROPRIETORSHIP
}

model InstitutionProfile {
  id Int @id @default(autoincrement())

  institutionName String
  sector          InstitutionSector @default(GENERIC)
  entityType      LegalEntityType   @default(TRUST)

  // Registration identifiers, all optional — a proprietorship may have none
  panNumber       String?
  gstNumber       String?
  cinOrLlpin      String? // company / LLP identification number
  registrationNo  String? // trust or society registration number
  charityRegNo    String? // 12A / 80G style registration, for charitable entities

  // Tax posture. Healthcare and school education are both largely exempt, so
  // input credit is usually blocked and tax gets capitalised into asset cost.
  isGstRegistered   Boolean @default(false)
  hasTaxableIncome  Boolean @default(false) // pharmacy, canteen, hostel, coaching…
  servicesAreExempt Boolean @default(true)

  // ── Accounting posture ────────────────────────────────
  // Companies file on useful life for the accounts AND written-down value for
  // the return, so they need two books. LLPs and proprietorships need one.
  maintainCompaniesActBook Boolean @default(false)
  maintainTaxBook          Boolean @default(true)

  // Charitable entities that claim an asset's cost as application of income
  // cannot also depreciate it. Switching this on makes the depreciation engine
  // read Asset.fundingSource and suppress depreciation where it applies.
  applyIncomeApplicationRule Boolean @default(false)

  fyStartMonth Int    @default(4) // 4 = April
  currency     String @default("INR")

  // Sector packs switched on for this deployment, comma separated:
  // HEALTHCARE | EDUCATION | TRANSPORT | LIBRARY
  enabledPacks String?

  addressLine String? @db.Text
  city        String?
  state       String?
  stateCode   String? // drives place-of-supply once GST lands
  pincode     String?

  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("institutionprofile")
}

/**
 * GST ON AN INWARD SUPPLY
 *
 * The tax on a purchase is not one number. It splits by head, and — far more
 * importantly — it splits between what can be claimed back and what becomes
 * part of what the asset cost. For an exempt hospital or school that second
 * figure is nearly all of it, and getting it wrong understates the asset and
 * overstates the credit at the same time.
 *
 * One row per tax invoice, bill of entry, credit note or self-invoice.
 */
model GstDocument {
  id Int @id @default(autoincrement())

  /// TAX_INVOICE | BILL_OF_ENTRY | RCM_SELF_INVOICE | CREDIT_NOTE | DEBIT_NOTE
  documentType String @default("TAX_INVOICE")

  goodsReceiptId    Int?
  goodsReceipt      GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderId   Int?
  purchaseVoucherId Int?
  externalPoId      Int?

  vendorId Int?
  vendor   Vendor? @relation("VendorGstDocuments", fields: [vendorId], references: [id])

  supplierGstin String?
  supplierName  String?
  invoiceNumber String
  invoiceDate   DateTime

  /// INTRA_STATE splits into CGST+SGST, INTER_STATE is IGST, IMPORT is IGST on
  /// the bill of entry plus customs duty that is never creditable.
  supplyType        String  @default("INTRA_STATE")
  placeOfSupplyCode String?

  taxableValue Decimal @db.Decimal(14, 2)
  cgstRate     Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstRate     Decimal @default(0) @db.Decimal(5, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  igstRate     Decimal @default(0) @db.Decimal(5, 2)
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  cessRate     Decimal @default(0) @db.Decimal(5, 2)
  cessAmount   Decimal @default(0) @db.Decimal(14, 2)

  /// Basic customs duty on an import. Never creditable — always part of cost.
  customsDuty Decimal @default(0) @db.Decimal(14, 2)

  totalTax     Decimal @db.Decimal(14, 2)
  invoiceTotal Decimal @db.Decimal(14, 2)

  /// Tax the institution pays itself rather than the supplier — goods
  /// transport, legal services, an import of services.
  isReverseCharge   Boolean   @default(false)
  rcmPaidAt         DateTime?
  rcmChallanRef     String?
  selfInvoiceNumber String?

  /// Capital goods get a longer credit life under Rule 43 and a different
  /// reversal treatment from inputs.
  isCapitalGoods Boolean @default(true)

  // ── The determination ──────────────────────────────────────────────
  /// FULL | BLOCKED_EXEMPT | BLOCKED_17_5 | PROPORTIONATE | NOT_REGISTERED
  itcEligibility    String  @default("BLOCKED_EXEMPT")
  /// Which limb of 17(5) blocks it, where that is the reason.
  blockedReasonCode String?
  eligibilityReason String? @db.Text

  itcClaimable    Decimal @default(0) @db.Decimal(14, 2)
  itcCapitalised  Decimal @default(0) @db.Decimal(14, 2)
  /// Claiming credit on the tax bars depreciating it — s.16(3) read with s.43(1)
  /// of the Income Tax Act. Set when the claim is made so depreciation knows.
  depreciationBarred Boolean @default(false)

  // ── Reconciliation against what the supplier actually filed ────────
  /// NOT_CHECKED | MATCHED | MISSING_IN_2B | VALUE_MISMATCH | EXTRA_IN_2B
  gstr2bStatus  String    @default("NOT_CHECKED")
  gstr2bPeriod  String?
  gstr2bValue   Decimal?  @db.Decimal(14, 2)
  gstr2bMatchedAt DateTime?
  gstr2bRemarks String?   @db.Text

  // ── Rule 37: pay the supplier within 180 days or give the credit back ──
  paymentDueBy   DateTime?
  isPaidInFull   Boolean   @default(false)
  paidInFullAt   DateTime?
  reversalDue    Boolean   @default(false)
  reversedAt     DateTime?
  reversalAmount Decimal?  @db.Decimal(14, 2)
  reclaimedAt    DateTime?

  /// Rule 43 spreads capital-goods common credit over sixty months.
  rule43MonthlyCredit Decimal? @db.Decimal(14, 2)
  rule43MonthsElapsed Int      @default(0)

  taxPeriod  String // MMYYYY, the period the credit belongs to
  fiscalYear Int

  status String @default("RECORDED") // RECORDED | CLAIMED | REVERSED | CANCELLED

  notes String? @db.Text

  lines GstDocumentLine[]

  createdById Int?
  createdBy   Employee? @relation("GstDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([fiscalYear, taxPeriod])
  @@index([vendorId])
  @@index([gstr2bStatus])
  @@index([goodsReceiptId])
  @@map("gstdocument")
}

/// HSN-wise breakup. Needed for the return summary, and for splitting tax
/// across assets when one invoice carries several.
model GstDocumentLine {
  id Int @id @default(autoincrement())

  gstDocumentId Int
  gstDocument   GstDocument @relation(fields: [gstDocumentId], references: [id], onDelete: Cascade)

  description String
  hsnCode     String?
  quantity    Decimal? @db.Decimal(12, 2)
  unit        String?

  taxableValue Decimal @db.Decimal(14, 2)
  taxRate      Decimal @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @db.Decimal(14, 2)
  cessAmount   Decimal @default(0) @db.Decimal(14, 2)

  assetId          Int?
  goodsReceiptLineId Int?

  createdAt DateTime @default(now())

  @@index([gstDocumentId])
  @@map("gstdocumentline")
}

/**
 * The monthly working for an institution with both exempt and taxable supply.
 * The apportionment ratio comes from turnover, which lives outside this system,
 * so finance enters it and everything downstream follows from it.
 */
model GstPeriodSummary {
  id Int @id @default(autoincrement())

  taxPeriod  String @unique // MMYYYY
  fiscalYear Int

  exemptTurnover  Decimal @default(0) @db.Decimal(16, 2)
  taxableTurnover Decimal @default(0) @db.Decimal(16, 2)
  totalTurnover   Decimal @default(0) @db.Decimal(16, 2)
  /// Share of turnover that is exempt — the proportion of common credit that
  /// has to be given back.
  exemptRatio     Decimal @default(0) @db.Decimal(7, 4)

  /// Rule 42 on inputs and services, Rule 43 on capital goods.
  rule42Reversal Decimal @default(0) @db.Decimal(14, 2)
  rule43Reversal Decimal @default(0) @db.Decimal(14, 2)

  totalItcAvailed  Decimal @default(0) @db.Decimal(14, 2)
  totalItcReversed Decimal @default(0) @db.Decimal(14, 2)
  netItcClaimed    Decimal @default(0) @db.Decimal(14, 2)

  rcmLiability Decimal @default(0) @db.Decimal(14, 2)
  rcmPaid      Decimal @default(0) @db.Decimal(14, 2)

  status String @default("OPEN") // OPEN | FINALISED
  returnFiledAt DateTime?
  returnRef     String?

  notes String? @db.Text

  preparedById Int?
  preparedBy   Employee? @relation("GstPeriodPreparedBy", fields: [preparedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([fiscalYear])
  @@map("gstperiodsummary")
}

/**
 * GSTR-2B RECONCILIATION
 *
 * The portal's own statement of what suppliers filed against this GSTIN.
 * Credit that is not in it cannot be taken, whatever the invoice in the file
 * says — so this is the document the books are checked against, not the other
 * way round.
 *
 * One row per import, holding the parsed lines and what each matched to.
 */
model Gstr2bImport {
  id Int @id @default(autoincrement())

  taxPeriod  String // MMYYYY as stated in the file
  fiscalYear Int

  /// What the portal says the statement covers, kept as-is for evidence.
  fileName      String?
  portalGstin   String?
  generatedOn   String?

  rowCount        Int @default(0)
  matchedCount    Int @default(0)
  mismatchCount   Int @default(0)
  missingInBooks  Int @default(0)
  missingIn2b     Int @default(0)

  totalTaxIn2b    Decimal @default(0) @db.Decimal(14, 2)
  totalTaxInBooks Decimal @default(0) @db.Decimal(14, 2)
  /// Credit the portal itself says is not available, whatever we concluded.
  blockedByPortal Decimal @default(0) @db.Decimal(14, 2)

  status String @default("PARSED") // PARSED | MATCHED | APPLIED | DISCARDED

  appliedAt DateTime?
  notes     String?   @db.Text

  rows Gstr2bRow[]

  importedById Int?
  importedBy   Employee? @relation("Gstr2bImportedBy", fields: [importedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([taxPeriod])
  @@map("gstr2bimport")
}

/// One invoice line as the portal reported it, and what it matched to here.
model Gstr2bRow {
  id       Int          @id @default(autoincrement())
  importId Int
  import   Gstr2bImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  /// B2B | B2BA | CDNR | CDNRA | IMPG | IMPGSEZ
  section String @default("B2B")

  supplierGstin String?
  supplierName  String?
  invoiceNumber String
  /// Punctuation and case stripped, so "INV/001" and "inv-001" meet.
  normalisedNumber String
  invoiceDate      DateTime?

  invoiceValue Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  cess         Decimal @default(0) @db.Decimal(14, 2)
  totalTax     Decimal @default(0) @db.Decimal(14, 2)

  placeOfSupply String?
  isReverseCharge Boolean @default(false)
  /// The portal's own verdict. "N" beats anything we concluded here.
  itcAvailable  Boolean @default(true)
  itcReason     String?
  supplierFiledOn String?
  sourceType      String? // e-Invoice | e-Invoice(SEZ) | null

  /// EXACT | NORMALISED | FUZZY | VALUE_MISMATCH | NOT_IN_BOOKS | AMBIGUOUS
  matchType   String  @default("NOT_IN_BOOKS")
  matchedDocumentId Int?
  taxDifference Decimal? @db.Decimal(14, 2)
  matchNote   String?  @db.Text

  createdAt DateTime @default(now())

  @@index([importId, matchType])
  @@index([normalisedNumber])
  @@map("gstr2brow")
}

// ═══════════════════════════════════════════════════════
// ACCOUNTING PERIODS — closing the books
// ═══════════════════════════════════════════════════════
// Once finance closes a month, nothing may be backdated into it. Every auditor
// assumes this and the system had no way to enforce it — a voucher dated last
// March could be posted today and quietly change a signed-off year.
model AccountingPeriod {
  id Int @id @default(autoincrement())

  fiscalYear  Int
  periodMonth Int // calendar month, 1–12
  periodLabel String // "Apr 2026"

  // OPEN   — normal working month
  // CLOSED — finance has closed it; a CFO can reopen with a reason
  // LOCKED — signed off after audit; not reopenable
  status String @default("OPEN")

  closedById Int?
  closedAt   DateTime?
  closeNotes String?   @db.Text

  reopenedById Int?
  reopenedAt   DateTime?
  reopenReason String?   @db.Text

  lockedById Int?
  lockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([fiscalYear, periodMonth])
  @@index([status])
  @@map("accountingperiod")
}

// ═══════════════════════════════════════════════════════
// APPROVAL DELEGATION — someone has to sign while you are away
// ═══════════════════════════════════════════════════════
// Without this, approvals stall or credentials get shared — and the second is
// what actually happens. A delegation is time-boxed and on the record, so the
// audit trail shows who really signed and on whose authority.
model ApprovalDelegation {
  id Int @id @default(autoincrement())

  // Whose authority is being lent
  delegatorId Int
  delegator   Employee @relation("DelegationFrom", fields: [delegatorId], references: [id])

  // Who may use it
  delegateId Int
  delegate   Employee @relation("DelegationTo", fields: [delegateId], references: [id])

  fromDate DateTime
  toDate   DateTime

  // ALL | PROCUREMENT | ACCOUNTS | INDENT
  scope String @default("ALL")

  reason   String  @db.Text
  isActive Boolean @default(true)

  // Set when the delegator comes back early
  revokedById Int?
  revokedAt   DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([delegateId, isActive])
  @@index([delegatorId, isActive])
  @@map("approvaldelegation")
}

// ═══════════════════════════════════════════════════════
// CAPITAL WORK IN PROGRESS — cost between payment and asset
// ═══════════════════════════════════════════════════════
// An asset's cost is not the invoice value. It is the invoice, plus freight,
// plus insurance in transit, plus customs where imported, plus installation
// and any site work done specifically for it — less any discount. Every one of
// those is capitalised and depreciated.
//
// Between the first payment and the day the machine is ready to use, that
// spend has nowhere to live. Here it accumulates, and on commissioning it
// transfers onto the asset as one built-up figure.
model CapitalWorkInProgress {
  id         Int    @id @default(autoincrement())
  cwipNumber String @unique // CWIP-FY2026-001

  description String

  // What it is being built for. Any of these may be set.
  purchaseOrderId Int?
  externalPoId    Int?
  indentId        Int?
  goodsReceiptId  Int?

  departmentId    Int?
  assetCategoryId Int?

  // OPEN — still accumulating
  // READY — everything incurred, waiting to be capitalised
  // CAPITALISED — transferred onto the assets, depreciation begins
  // CANCELLED — abandoned; the spend is written off rather than capitalised
  status String @default("OPEN")

  // Cache of the component rows, kept in step so list screens do not aggregate
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  capitalisedAt   DateTime?
  capitalisedById Int?
  // The figure actually transferred, kept because components can still be
  // added afterwards for a later correction.
  capitalisedAmount Decimal? @db.Decimal(14, 2)

  cancelReason String? @db.Text
  notes        String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  components AcquisitionCostComponent[]
  assets     Asset[]                    @relation("CwipAssets")

  @@index([status])
  @@index([purchaseOrderId])
  @@map("capitalworkinprogress")
}

// One line of the build-up, each traceable to the document it came from.
// Without the source reference this is just a pile of numbers an auditor
// cannot follow back.
model AcquisitionCostComponent {
  id     Int                   @id @default(autoincrement())
  cwipId Int
  cwip   CapitalWorkInProgress @relation(fields: [cwipId], references: [id], onDelete: Cascade)

  // BASIC | FREIGHT | INSURANCE | CUSTOMS_DUTY | CLEARING_CHARGES |
  // INSTALLATION | SITE_PREPARATION | NON_CREDITABLE_TAX | TESTING |
  // PROFESSIONAL_FEES | DISCOUNT | OTHER
  componentType String
  description   String?

  // Negative for a discount, so the build-up simply sums
  amount Decimal @db.Decimal(14, 2)

  // INVOICE | GRN | WORK_ORDER | PAYMENT_VOUCHER | BILL_OF_ENTRY | MANUAL
  sourceType String?
  sourceRef  String?
  incurredDate DateTime?

  // Not everything spent around an asset belongs in its cost — training,
  // consumables and running costs are expensed, not capitalised.
  isCapitalisable Boolean @default(true)

  notes String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([cwipId])
  @@map("acquisitioncostcomponent")
}

// ═══════════════════════════════════════════════════════
// QUOTATIONS — what was offered, and why one was chosen
// ═══════════════════════════════════════════════════════
// Before this, a purchase order simply named a vendor with nothing behind the
// choice. Quotations record what each vendor offered, which one won, and the
// reason — which is the first thing an auditor asks about.
//
// Clinical and laboratory equipment is judged on technical suitability FIRST
// and price second, so a quotation carries a technical verdict of its own. A
// straight price comparison across unqualified bids is not a comparison.
model PurchaseQuotation {
  id Int @id @default(autoincrement())

  // The vendor's own reference on their quote
  quotationNo   String
  quotationDate DateTime @default(now())

  indentId Int
  indent   AssetIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  // Set where a quote covers one line of a multi-line indent rather than all of it
  indentLineId Int?
  indentLine   AssetIndentLine? @relation(fields: [indentLineId], references: [id])

  vendorId Int
  vendor   Vendor @relation("QuotationVendor", fields: [vendorId], references: [id])

  quotedAmount     Decimal  @db.Decimal(14, 2)
  // What was actually agreed after negotiation. Kept apart from the quote so
  // the saving is visible rather than overwritten.
  negotiatedAmount Decimal? @db.Decimal(14, 2)
  currency         String   @default("INR")

  promisedDeliveryDate DateTime?
  deliveryDays         Int?
  validUntil           DateTime?
  paymentTerms         String?   @db.Text
  warrantyMonths       Int?

  attachmentUrl String?
  notes         String? @db.Text

  // ── Technical evaluation, before price is looked at ──
  technicalStatus  String    @default("PENDING") // PENDING | QUALIFIED | DISQUALIFIED
  technicalRemarks String?   @db.Text
  technicalById    Int?
  technicalAt      DateTime?

  // ── Commercial selection ──
  isSelected      Boolean   @default(false)
  // LOWEST_PRICE | FASTEST_DELIVERY | ONLY_QUALIFIED | TECHNICAL_FIT |
  // RATE_CONTRACT | EXISTING_VENDOR | SOLE_SOURCE
  selectionBasis  String?
  selectionReason String?   @db.Text
  selectedById    Int?
  selectedAt      DateTime?

  purchaseOrderId Int? // set once the winning quote becomes an order

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines PurchaseQuotationLine[]

  @@unique([indentId, vendorId, quotationNo])
  @@index([indentId])
  @@index([vendorId])
  @@map("purchasequotation")
}

model PurchaseQuotationLine {
  id          Int               @id @default(autoincrement())
  quotationId Int
  quotation   PurchaseQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  lineNumber  Int
  description String
  makeModel   String? // what the vendor actually offered against the spec

  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  taxPercent Decimal? @db.Decimal(5, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)

  specifications String? @db.Text

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@map("purchasequotationline")
}

// ═══════════════════════════════════════════════════════
// ASSET DEPARTMENT — who technically verifies what
// ═══════════════════════════════════════════════════════
// The department that vets an indent is not fixed: biomedical engineering
// verifies medical equipment, IT verifies computers, estates verifies civil
// work. Responsibility is mapped per category, with a fallback department for
// anything unmapped so an indent never lands nowhere.
model AssetDepartmentConfig {
  id Int @id @default(autoincrement())

  departmentId Int
  department   Department @relation("AssetDeptConfig", fields: [departmentId], references: [id])

  // Null means "everything not mapped to someone else" — the catch-all.
  assetCategoryId Int?
  assetCategory   AssetCategory? @relation(fields: [assetCategoryId], references: [id])

  // Exactly one row should carry this. Used when a category has no owner.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  notes String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([departmentId, assetCategoryId])
  @@index([assetCategoryId, isActive])
  @@map("assetdepartmentconfig")
}

// ═══════════════════════════════════════════════════════
// INDENT LINES — one request, several things
// ═══════════════════════════════════════════════════════
// The header keeps its original fields as a running summary, so every existing
// screen, report and purchase-order path continues to read what it always did.
// Lines carry the detail, and each one is verified, negotiated and fulfilled on
// its own — a five-line indent can have one line issued from stock, one
// renegotiated and three sent to purchase.
model AssetIndentLine {
  id       Int         @id @default(autoincrement())
  indentId Int
  indent   AssetIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  lineNumber Int
  assetName  String

  assetCategoryId Int?
  assetCategory   AssetCategory? @relation("IndentLineCategory", fields: [assetCategoryId], references: [id])

  quantity          Int      @default(1)
  estimatedUnitCost Decimal? @db.Decimal(12, 2)
  estimatedBudget   Decimal? @db.Decimal(14, 2)

  specifications String? @db.Text
  justification  String? @db.Text

  // ── Asset department verification, per line ──
  // PENDING | VERIFIED | REVISED | ISSUED_FROM_STOCK | REJECTED
  verificationStatus    String? @default("PENDING")
  revisedSpecifications String? @db.Text
  revisedQuantity       Int?
  verifiedById          Int?
  verifiedAt            DateTime?
  verifyRemarks         String?   @db.Text

  // ── Fulfilment, per line ──
  qtyFromStock Int  @default(0)
  qtyToProcure Int?

  // PENDING | ISSUED_FROM_STOCK | PROCUREMENT | DELIVERED | CLOSED | REJECTED
  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  negotiations IndentSpecNegotiation[]
  quotations   PurchaseQuotation[]
  specs        IndentLineSpec[]

  @@unique([indentId, lineNumber])
  @@index([indentId])
  @@map("assetindentline")
}

// ═══════════════════════════════════════════════════════
// SPEC NEGOTIATION — "you asked for 5 GB, we hold 2.5"
// ═══════════════════════════════════════════════════════
// Every round is kept, in both directions, so the specification that finally
// gets bought carries the reason it changed.
model IndentSpecNegotiation {
  id       Int         @id @default(autoincrement())
  indentId Int
  indent   AssetIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  indentLineId Int?
  indentLine   AssetIndentLine? @relation(fields: [indentLineId], references: [id], onDelete: Cascade)

  round Int @default(1)

  // ASSET_DEPT | REQUESTER — who is making this proposal
  proposedBy     String
  proposedById   Int?
  proposedSpec   String  @db.Text
  proposedQuantity Int?
  reason         String  @db.Text

  // PENDING | ACCEPTED | DECLINED | COUNTERED
  responseStatus  String    @default("PENDING")
  respondedById   Int?
  respondedAt     DateTime?
  responseRemarks String?   @db.Text

  createdAt DateTime @default(now())

  @@index([indentId])
  @@index([indentLineId])
  @@map("indentspecnegotiation")
}

// ═══════════════════════════════════════════════════════
// SECOND DEPRECIATION BOOK — Companies Act alongside Income Tax
// ═══════════════════════════════════════════════════════
// A company files on useful life for its financial statements AND on
// written-down value for its tax return, so the same machine carries two
// different values in the same year.
//
// AssetDepreciation remains the Income Tax book — it is live, it holds every
// existing client's history, and its half-year and written-down-value logic is
// tax logic. The Companies Act book lives here instead of reshaping a table
// that trusts are depreciating against today.

enum DepreciationBook {
  TAX // Income Tax Act — written-down value, block of assets
  COMPANIES_ACT // Schedule II — useful life, pro-rata from date of use
}

model AssetDepreciationBook {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation("AssetDepBooks", fields: [assetId], references: [id])

  book DepreciationBook @default(COMPANIES_ACT)

  method          String // SLM | WDV
  usefulLifeYears Int
  // Schedule II caps the residual at 5% of original cost
  residualPercent Decimal @default(5) @db.Decimal(5, 2)

  // Frozen at enrolment. The tax book may carry a different cost — a trust
  // capitalising blocked tax, for instance — so it is stored, not derived.
  grossCost Decimal @db.Decimal(14, 2)

  // Ready-for-use date, which is what Schedule II runs from — not the invoice
  // date, and not necessarily the tax book's start.
  depreciationStart DateTime
  lastCalculatedAt  DateTime?

  accumulatedDepreciation Decimal  @default(0) @db.Decimal(14, 2)
  currentBookValue        Decimal? @db.Decimal(14, 2)

  isActive Boolean @default(true)
  notes    String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([assetId, book])
  @@index([book, isActive])
  @@map("assetdepreciationbook")
}

// Per-category defaults, so enrolling an asset does not mean typing a useful
// life every time. Schedule II fixes lives by class of asset; the Income Tax
// Act fixes rates by block.
model CategoryDepreciationRule {
  id              Int              @id @default(autoincrement())
  assetCategoryId Int
  assetCategory   AssetCategory    @relation(fields: [assetCategoryId], references: [id])
  book            DepreciationBook

  method String // SLM | WDV

  // Companies Act
  usefulLifeYears Int?
  residualPercent Decimal? @db.Decimal(5, 2)

  // Income Tax — the block this category falls in
  ratePercent Decimal? @db.Decimal(5, 2)
  blockName   String?

  notes String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([assetCategoryId, book])
  @@map("categorydepreciationrule")
}

// ═══════════════════════════════════════════════════════
// LICENCE & CERTIFICATE REGISTER — one model, many regimes
// ═══════════════════════════════════════════════════════
// Deliberately generic. The same shape covers a school bus fitness
// certificate, a hospital radiation approval, an ultrasound registration, an
// electrical safety test, a waste authorisation and an affiliation — all of
// which are "a document, from an authority, that expires, and sometimes
// belongs to a specific asset".
//
// Building one register instead of six is the difference between a week and a
// quarter, and it means a new regime is a new type value rather than a new
// module.
model AssetLicence {
  id Int @id @default(autoincrement())

  // FITNESS | PERMIT | POLLUTION | ROAD_TAX | VEHICLE_INSURANCE | DRIVER_LICENCE
  // RADIATION | ULTRASOUND_REGN | ELECTRICAL_SAFETY | CALIBRATION_CERT
  // WASTE_AUTHORISATION | AFFILIATION | ACCREDITATION | FIRE_NOC | OTHER
  licenceType   String
  licenceNumber String
  title         String? // free label where the type alone is not enough

  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?

  // ACTIVE | EXPIRING | EXPIRED | SURRENDERED | SUSPENDED
  status String @default("ACTIVE")

  // Asset-specific (a bus, a scanner) or institution-wide (an affiliation).
  assetId Int?
  asset   Asset? @relation("AssetLicences", fields: [assetId], references: [id])

  // For licences that belong to a person rather than a machine — drivers,
  // radiation safety officers, registered sonographers.
  holderName     String?
  holderEmployeeId Int?

  departmentId Int?
  branchId     Int?

  documentUrl String?
  cost        Decimal? @db.Decimal(12, 2)

  // Days before expiry to start warning. Null falls back to the tenant default.
  reminderDays Int?

  // Some regimes forbid moving or disposing of the asset while the licence is
  // live — an ultrasound machine cannot simply be sold on.
  blocksTransfer Boolean @default(false)
  blocksDisposal Boolean @default(false)

  remarks String? @db.Text

  renewedFromId Int? // chain of renewals, newest points at its predecessor

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([licenceType, status])
  @@index([expiryDate])
  @@index([assetId])
  @@map("assetlicence")
}

// ═══════════════════════════════════════════════════════
// LIBRARY ACCESSION REGISTER — education pack
// ═══════════════════════════════════════════════════════
// High count, low value per item — closer to inventory than to the fixed asset
// register, so it lives in its own table rather than clogging Asset. An
// institution with 40,000 books should not have 40,000 rows in the asset
// register, each carrying depreciation and assignment machinery it never uses.
model LibraryItem {
  id Int @id @default(autoincrement())

  accessionNo String  @unique // the running number that defines the register
  title       String
  author      String?
  publisher   String?
  edition     String?
  isbn        String?

  // BOOK | JOURNAL | PERIODICAL | THESIS | REPORT | CD_DVD | EBOOK | MAP | OTHER
  itemType String  @default("BOOK")
  subject  String?
  language String?

  // PURCHASE | DONATION | GRANT | EXCHANGE
  source      String?  @default("PURCHASE")
  cost        Decimal? @db.Decimal(10, 2)
  vendorId    Int?
  vendor      Vendor?  @relation("LibraryVendor", fields: [vendorId], references: [id])
  billNo      String?
  purchaseDate DateTime?

  // Where it physically sits
  location String? // rack / shelf / section
  callNo   String?

  departmentId Int?
  branchId     Int?

  // AVAILABLE | ISSUED | IN_BINDING | LOST | DAMAGED | WITHDRAWN
  status String @default("AVAILABLE")

  // Withdrawal — the library equivalent of condemnation. Lost, obsolete or
  // beyond repair items leave the register but stay on the record.
  withdrawnAt     DateTime?
  withdrawnReason String?   @db.Text
  withdrawnById   Int?

  // Stock verification — the annual walk
  lastVerifiedAt DateTime?
  lastVerifiedById Int?

  remarks String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([itemType])
  @@index([title])
  @@map("libraryitem")
}

// How an asset was paid for. Needed in two places at once:
//   • charitable entities — an asset funded from income already claimed as
//     application cannot be depreciated again
//   • education — grant-funded assets carry conditions on use and disposal
enum AssetFundingSource {
  OWN_INCOME // revenue of the year, may have been claimed as application
  CORPUS // corpus or capital fund
  GRANT // government or agency grant, usually with conditions
  DONATION // donated in kind or cash-specific
  LOAN // borrowed funds
  INTERNAL_ACCRUAL
}

// ═══════════════════════════════════════════════════════
// STORE — Multi-tier warehouse hierarchy
// ═══════════════════════════════════════════════════════
model Store {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  code      String? @unique
  storeType String  @default("MAIN_STORE") // MAIN_STORE | SUB_STORE

  parentStoreId Int?
  parentStore   Store?  @relation("StoreHierarchy", fields: [parentStoreId], references: [id])
  childStores   Store[] @relation("StoreHierarchy")

  branchId     Int?
  departmentId Int?
  managerId    Int?
  address      String? @db.Text
  isActive     Boolean @default(true)

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  locations          StoreLocation[]
  stockPositions     StoreStockPosition[]
  transfersFrom      StoreTransfer[]      @relation("TransferFromStore")
  transfersTo        StoreTransfer[]      @relation("TransferToStore")
  materialIssues     MaterialIssue[]
  goodsReceiptLines  GoodsReceiptLine[]   @relation("GRALineStore")
  purchaseOrderLines PurchaseOrderLine[]  @relation("POLineStore")
  stagedAssets       Asset[]              @relation("AssetCurrentStore")
  indentIssues       IndentStoreIssue[]
  stockReservations  StockReservation[]

  @@map("store")
}

model StoreLocation {
  id       Int     @id @default(autoincrement())
  storeId  Int
  store    Store   @relation(fields: [storeId], references: [id])
  rack     String?
  shelf    String?
  bin      String?
  label    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([storeId, rack, shelf, bin])
  @@map("storelocation")
}

// ═══════════════════════════════════════════════════════
// ROOT CAUSE ANALYSIS — 5 Whys + 6M structured framework
// ═══════════════════════════════════════════════════════
model RootCauseAnalysis {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  framework        String // FIVE_WHYS | SIX_M | COMBINED
  summary          String? @db.Text
  conclusion       String? @db.Text
  correctiveAction String? @db.Text
  preventiveAction String? @db.Text

  performedById Int?
  performedAt   DateTime?
  status        String    @default("DRAFT") // DRAFT | COMPLETED | REVIEWED

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  fiveWhys  RcaFiveWhy[]
  sixMItems RcaSixMItem[]

  @@index([ticketId])
  @@map("rootcauseanalysis")
}

model RcaFiveWhy {
  id    Int               @id @default(autoincrement())
  rcaId Int
  rca   RootCauseAnalysis @relation(fields: [rcaId], references: [id])

  whyNumber Int
  question  String @db.Text
  answer    String @db.Text

  @@index([rcaId])
  @@map("rcafivewhy")
}

model RcaSixMItem {
  id    Int               @id @default(autoincrement())
  rcaId Int
  rca   RootCauseAnalysis @relation(fields: [rcaId], references: [id])

  category String // MAN | MACHINE | MATERIAL | METHOD | MEASUREMENT | MOTHER_NATURE
  cause    String  @db.Text
  isRoot   Boolean @default(false)

  @@index([rcaId])
  @@map("rcasixmitem")
}

// ═══════════════════════════════════════════════════════
// PURCHASE ORDER — Separate procurement module
// ═══════════════════════════════════════════════════════
model PurchaseOrder {
  id       Int      @id @default(autoincrement())
  poNumber String   @unique
  poDate   DateTime @default(now())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  status String @default("DRAFT") // DRAFT | SUBMITTED | HOD_APPROVED | MGMT_APPROVED | SENT_TO_VENDOR | PARTIALLY_RECEIVED | FULLY_RECEIVED | CANCELLED | CLOSED

  // Optional linkage to indent
  indentId Int?
  indent   AssetIndent? @relation(fields: [indentId], references: [id])

  departmentId Int?
  department   Department? @relation("PODepartment", fields: [departmentId], references: [id])

  // Financial
  subtotal    Decimal? @db.Decimal(14, 2)
  taxAmount   Decimal? @db.Decimal(14, 2)
  totalAmount Decimal? @db.Decimal(14, 2)
  currency    String   @default("INR")

  // Approval chain (amount-based routing)
  hodApprovedById  Int?
  hodApprovedAt    DateTime?
  hodRemarks       String?   @db.Text
  mgmtApprovedById Int?
  mgmtApprovedAt   DateTime?
  mgmtRemarks      String?   @db.Text
  cooApprovedById  Int?
  cooApprovedAt    DateTime?
  cooRemarks       String?   @db.Text
  cfoApprovedById  Int?
  cfoApprovedAt    DateTime?
  cfoRemarks       String?   @db.Text
  approvalLevel    String? // HOD | MANAGEMENT | COO | CFO — highest level needed based on amount

  // Amendment tracking
  amendmentCount Int      @default(0)
  isAmended      Boolean  @default(false)
  originalAmount Decimal? @db.Decimal(14, 2)

  // Advance payment terms — accounts raise the advance voucher from these
  // once the PO is dispatched to the vendor.
  advancePercent Decimal?  @db.Decimal(5, 2)
  advanceAmount  Decimal?  @db.Decimal(14, 2)
  advancePaidAt  DateTime?
  // When the advance was set off against the payable in the ledger. Guards the
  // adjustment entry so it is posted once, not on every later payment.
  advanceAdjustedAt DateTime?

  // TAT milestone: when the PO was dispatched to the vendor
  sentToVendorAt DateTime?

  deliveryDate    DateTime?
  paymentTerms    String?   @db.Text
  shippingAddress String?   @db.Text
  notes           String?   @db.Text

  // Liquidated damages. Agreed on the order; charged from the goods receipt.
  // Nil rates mean the order carries no delay clause.
  ldPercentPerWeek Decimal? @db.Decimal(5, 2)
  ldMaxPercent     Decimal? @db.Decimal(5, 2)
  /// DELAYED_VALUE charges only the late portion; ORDER_VALUE charges the whole
  /// order however little arrived late.
  ldBasis          String?  @default("DELAYED_VALUE")
  /// Days the vendor gets before the clock starts.
  ldGraceDays      Int?     @default(0)

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines             PurchaseOrderLine[]
  goodsReceipts     GoodsReceipt[]
  assets            Asset[]                  @relation("POAssets")
  amendments        PurchaseOrderAmendment[]
  matches           ProcurementMatch[]
  paymentVouchers   PaymentVoucher[]         @relation("POPaymentVouchers")
  liquidatedDamages LiquidatedDamage[]

  @@index([vendorId])
  @@index([status])
  @@index([indentId])
  @@map("purchaseorder")
}

model PurchaseOrderAmendment {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  amendmentNumber Int // 1, 2, 3...
  reason          String  @db.Text
  previousAmount  Decimal @db.Decimal(14, 2)
  newAmount       Decimal @db.Decimal(14, 2)
  changeAmount    Decimal @db.Decimal(14, 2) // newAmount - previousAmount (can be negative)

  // Snapshot of what changed
  changesJson Json? // { linesAdded: [], linesModified: [], linesRemoved: [] }

  // An amendment is raised by the Purchase team but walks the SAME amount-slab
  // approval chain as a PO, re-derived from `newAmount`. A ₹80k PO amended to
  // ₹6L therefore needs COO sign-off, not just Finance.
  // PENDING | HOD_APPROVED | MGMT_APPROVED | COO_APPROVED | APPROVED | REJECTED
  status        String  @default("PENDING")
  approvalLevel String? // HOD | MANAGEMENT | COO | CFO — highest level needed for newAmount

  hodApprovedById  Int?
  hodApprovedAt    DateTime?
  hodRemarks       String?   @db.Text
  mgmtApprovedById Int?
  mgmtApprovedAt   DateTime?
  mgmtRemarks      String?   @db.Text
  cooApprovedById  Int?
  cooApprovedAt    DateTime?
  cooRemarks       String?   @db.Text
  cfoApprovedById  Int?
  cfoApprovedAt    DateTime?
  cfoRemarks       String?   @db.Text

  // Final decision (set when the last required level signs, or on rejection)
  approvedById Int?
  approvedAt   DateTime?
  remarks      String?   @db.Text

  rejectedById Int?
  rejectedAt   DateTime?

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([status])
  @@map("purchaseorderamendment")
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  lineNumber  Int
  itemType    String // ASSET | SPARE_PART | CONSUMABLE | SERVICE
  description String

  assetCategoryId Int?
  sparePartId     Int?
  consumableId    Int?

  storeId Int?
  store   Store? @relation("POLineStore", fields: [storeId], references: [id])

  // Source indent for this line — set when the PO clubs one or more approved
  // indents (each indent becomes one traceable line).
  indentId Int?
  indent   AssetIndent? @relation("POLineIndent", fields: [indentId], references: [id])

  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  taxPercent Decimal? @db.Decimal(5, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)

  receivedQty Int  @default(0)
  pendingQty  Int?

  // Partial cancellation — a line no longer needed is dropped here rather than
  // forcing an amendment of the whole order. The commitment is released for
  // the cancelled value only.
  cancelledQty  Int       @default(0)
  lineStatus    String    @default("ACTIVE") // ACTIVE | PART_CANCELLED | CANCELLED
  cancelReason  String?   @db.Text
  cancelledById Int?
  cancelledAt   DateTime?

  hsnCode        String?
  specifications String? @db.Text

  createdAt DateTime @default(now())

  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([indentId])
  @@map("purchaseorderline")
}

// ═══════════════════════════════════════════════════════
// GOODS RECEIPT (GRA/GRN) — Receipt and inspection
// ═══════════════════════════════════════════════════════
model GoodsReceipt {
  id        Int      @id @default(autoincrement())
  grnNumber String   @unique
  grnDate   DateTime @default(now())

  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // Clients without the PO module (e.g. JMRH) receive against a PO raised
  // outside the system — the approved value on that reference is the baseline
  // the tax invoice is matched against.
  externalPoId Int?
  externalPo   ExternalPurchaseOrder? @relation(fields: [externalPoId], references: [id])

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  status String @default("DRAFT") // DRAFT | INSPECTION_PENDING | INSPECTION_PASSED | INSPECTION_FAILED | ACCEPTED | PARTIALLY_ACCEPTED | REJECTED

  inspectedById     Int?
  inspectedAt       DateTime?
  inspectionRemarks String?   @db.Text

  // TAT milestone: when the receipt was accepted (assets created)
  acceptedAt DateTime?

  deliveryChallanNo String?
  deliveryDate      DateTime?
  receivedById      Int?

  invoiceNumber String?
  invoiceDate   DateTime?
  invoiceValue  Decimal?  @db.Decimal(14, 2)

  totalValue Decimal? @db.Decimal(14, 2)
  notes      String?  @db.Text

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines            GoodsReceiptLine[]
  assets           Asset[]            @relation("GRAAssets")
  purchaseVouchers PurchaseVoucher[]  @relation("GRAPurchaseVouchers")
  match            ProcurementMatch?
  returns          GoodsReturn[]
  commissioningSignoffs CommissioningSignoff[]
  liquidatedDamages     LiquidatedDamage[]
  gstDocuments          GstDocument[]

  @@index([purchaseOrderId])
  @@index([externalPoId])
  @@index([status])
  @@map("goodsreceipt")
}

model GoodsReceiptLine {
  id             Int          @id @default(autoincrement())
  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  poLineId Int?
  poLine   PurchaseOrderLine? @relation(fields: [poLineId], references: [id])

  itemType    String // ASSET | SPARE_PART | CONSUMABLE
  description String

  receivedQty Int
  acceptedQty Int @default(0)
  rejectedQty Int @default(0)

  storeId Int?
  store   Store? @relation("GRALineStore", fields: [storeId], references: [id])

  unitPrice Decimal? @db.Decimal(12, 2)
  lineTotal Decimal? @db.Decimal(14, 2)

  inspectionStatus  String? // PASS | FAIL | PARTIAL
  inspectionRemarks String? @db.Text

  createdAssetId Int?
  // For bulk lines this holds MULTIPLE serials (one per unit),
  // comma/newline-separated — hence Text, not varchar
  serialNumber   String? @db.Text

  createdAt DateTime @default(now())

  returnLines GoodsReturnLine[]

  @@index([goodsReceiptId])
  @@index([poLineId])
  @@map("goodsreceiptline")
}

// ═══════════════════════════════════════════════════════
// EXTERNAL PURCHASE ORDER — PO raised outside Smart Assets
// ═══════════════════════════════════════════════════════
// For tenants without the PO module (e.g. JMRH). The team records the PO
// number and the value it was approved for; that value is the baseline every
// tax invoice is matched against, so the payment gate works identically to
// the in-system flow.
model ExternalPurchaseOrder {
  id       Int      @id @default(autoincrement())
  poNumber String   @unique
  poDate   DateTime @default(now())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // The approved value. Mandatory — without it there is nothing to match
  // an invoice against and the variance control silently disappears.
  approvedAmount Decimal @db.Decimal(14, 2)
  currency       String  @default("INR")

  approvedBy    String? // name/designation from the signed paper PO
  attachmentUrl String? // scan of the signed PO

  indentId Int?
  indent   AssetIndent? @relation(fields: [indentId], references: [id])

  departmentId Int?
  branchId     Int?

  status String  @default("ACTIVE") // ACTIVE | CLOSED | CANCELLED
  notes  String? @db.Text

  enteredById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  goodsReceipts   GoodsReceipt[]
  matches         ProcurementMatch[]
  paymentVouchers PaymentVoucher[]

  @@index([vendorId])
  @@index([status])
  @@index([indentId])
  @@map("externalpurchaseorder")
}

// ═══════════════════════════════════════════════════════
// PROCUREMENT MATCH — three-way match (PO vs receipt vs invoice)
// ═══════════════════════════════════════════════════════
// Computed automatically when a goods receipt is saved. When the invoice
// exceeds the approved value beyond tolerance the match holds ALL payment on
// the order until the CFO explicitly accepts the variance.
model ProcurementMatch {
  id Int @id @default(autoincrement())

  goodsReceiptId Int          @unique
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  externalPoId    Int?
  externalPo      ExternalPurchaseOrder? @relation(fields: [externalPoId], references: [id])

  approvedAmount Decimal @db.Decimal(14, 2) // PO total at its latest approved amendment
  receivedAmount Decimal @db.Decimal(14, 2) // accepted qty x PO rate
  invoiceAmount  Decimal @db.Decimal(14, 2) // this receipt's tax invoice value

  // Every invoice raised against the order so far, this one included. Variance
  // is measured on THIS, not on the single invoice — otherwise a vendor can
  // split an over-billed amount across two receipts and clear both.
  cumulativeInvoiced Decimal @default(0) @db.Decimal(14, 2)

  varianceAmount  Decimal @db.Decimal(14, 2) // cumulativeInvoiced - approved (negative = favourable)
  variancePercent Decimal @db.Decimal(8, 2)

  // THREE_WAY — approved vs received vs invoiced, the full check.
  // TWO_WAY   — approved vs invoiced only, because no receipt on this order
  //             carries line detail (a client whose own system booked the
  //             goods). Recorded so a two-way pass is never read as a three-way
  //             one: nothing here proves the goods arrived.
  matchType String @default("THREE_WAY")

  // MATCHED | WITHIN_TOLERANCE | FAVOURABLE | QTY_VARIANCE | VARIANCE_HOLD |
  // CFO_APPROVED | REJECTED
  status String @default("MATCHED")

  paymentBlocked Boolean @default(false)
  blockReason    String? @db.Text

  cfoApprovedById Int?
  cfoApprovedAt   DateTime?
  cfoRemarks      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([purchaseOrderId])
  @@index([externalPoId])
  @@map("procurementmatch")
}

// ═══════════════════════════════════════════════════════
// COMMISSIONING SIGN-OFF — physical gate before final payment
// ═══════════════════════════════════════════════════════
// The finance/technical verifier confirms the asset is installed and working
// before the balance payment to the vendor can be released.
model CommissioningSignoff {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  goodsReceiptId Int?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  indentId       Int?
  indent         AssetIndent?  @relation(fields: [indentId], references: [id])

  installedAt      DateTime?
  workingCondition String? // WORKING | PARTIAL | FAULTY
  status           String  @default("PENDING") // PENDING | VERIFIED | DEFECT_REPORTED

  verifiedById Int?
  verifiedAt   DateTime?
  remarks      String?   @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([goodsReceiptId])
  @@map("commissioningsignoff")
}

// ═══════════════════════════════════════════════════════
// INDENT STORE ISSUE — stock issued against an indent
// ═══════════════════════════════════════════════════════
// Records what Stores handed over from existing stock, so an indent closed
// without a purchase order still has a traceable fulfilment line.
model IndentStoreIssue {
  id Int @id @default(autoincrement())

  indentId Int
  indent   AssetIndent @relation(fields: [indentId], references: [id])

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id])

  storeId Int?
  store   Store? @relation(fields: [storeId], references: [id])

  itemType     String @default("ASSET") // ASSET | SPARE_PART | CONSUMABLE
  sparePartId  Int?
  consumableId Int?
  description  String?

  quantity Int @default(1)

  issuedById Int?
  issuedAt   DateTime @default(now())
  remarks    String?  @db.Text

  createdAt DateTime @default(now())

  @@index([indentId])
  @@index([assetId])
  @@map("indentstoreissue")
}

// ═══════════════════════════════════════════════════════
// WORK ORDER — OpEx maintenance + CapEx project works
// ═══════════════════════════════════════════════════════
model WorkOrder {
  id       Int      @id @default(autoincrement())
  woNumber String   @unique
  woDate   DateTime @default(now())
  woType   String // OPEX | CAPEX

  assetId  Int?
  asset    Asset?  @relation("AssetWorkOrders", fields: [assetId], references: [id])
  ticketId Int?
  ticket   Ticket? @relation("TicketWorkOrders", fields: [ticketId], references: [id])

  description String @db.Text
  priority    String @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL

  departmentId Int?
  assignedToId Int?

  status String @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | IN_PROGRESS | PENDING_MATERIAL | WORK_COMPLETED | WCC_ISSUED | CLOSED | CANCELLED

  // Financial
  estimatedCost Decimal? @db.Decimal(14, 2)
  actualCost    Decimal? @db.Decimal(14, 2)
  budgetCode    String?

  // CAPEX specific
  capitalizeAsAsset  Boolean @default(false)
  assetCategoryId    Int?
  capitalizedAssetId Int?

  // CapEx assets created from this WO
  capitalizedAssets Asset[] @relation("CapExAssets")

  // Approval
  approvedById    Int?
  approvedAt      DateTime?
  approvalRemarks String?   @db.Text

  // Scheduling
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  // Contractor / vendor
  contractorVendorId Int?
  contractorName     String?
  laborCost          Decimal? @db.Decimal(12, 2)
  nonMaterialCost    Decimal? @db.Decimal(12, 2)

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  materialIssues  MaterialIssue[]
  wcc             WorkCompletionCertificate?
  rcas            RootCauseAnalysis[]
  paymentVouchers PaymentVoucher[]           @relation("WOPaymentVouchers")

  @@index([assetId])
  @@index([ticketId])
  @@index([status])
  @@map("workorder")
}

model WorkCompletionCertificate {
  id          Int       @id @default(autoincrement())
  workOrderId Int       @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  wccNumber String   @unique
  wccDate   DateTime @default(now())

  workSummary          String   @db.Text
  materialsUsedSummary String?  @db.Text
  totalLaborCost       Decimal? @db.Decimal(12, 2)
  totalMaterialCost    Decimal? @db.Decimal(12, 2)
  totalCost            Decimal? @db.Decimal(14, 2)

  qualityCheckStatus String? // PASS | FAIL | CONDITIONAL
  qualityRemarks     String? @db.Text

  certifiedById Int?
  certifiedAt   DateTime?
  acceptedById  Int?
  acceptedAt    DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("workcompletioncertificate")
}

model MaterialIssue {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  issueType    String // SPARE_PART | CONSUMABLE
  sparePartId  Int?
  sparePart    SparePart?  @relation("MaterialIssueSparePart", fields: [sparePartId], references: [id])
  consumableId Int?
  consumable   Consumable? @relation("MaterialIssueConsumable", fields: [consumableId], references: [id])
  description  String?

  quantity  Decimal  @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  totalCost Decimal? @db.Decimal(12, 2)

  issuedById Int?
  issuedAt   DateTime @default(now())
  remarks    String?

  inventoryTransactionId Int?

  createdAt DateTime @default(now())

  @@index([workOrderId])
  @@index([storeId])
  @@map("materialissue")
}

// ═══════════════════════════════════════════════════════
// STORE STOCK & TRANSFERS — Inventory management
// ═══════════════════════════════════════════════════════
model StoreStockPosition {
  id      Int   @id @default(autoincrement())
  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  itemType     String // SPARE_PART | CONSUMABLE
  sparePartId  Int?
  consumableId Int?

  currentQty   Decimal @default(0) @db.Decimal(12, 2)
  reservedQty  Decimal @default(0) @db.Decimal(12, 2)
  availableQty Decimal @default(0) @db.Decimal(12, 2)

  reorderLevel Decimal? @db.Decimal(12, 2)
  maxLevel     Decimal? @db.Decimal(12, 2)

  lastUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
