// ── Firebase Cloud Messaging device tokens ─────────────────────────────────
// One row per device. The mobile client upserts on login and removes on logout.
// Tokens that return INVALID / NOT_REGISTERED on send are cleaned up by the
// push helper so the table self-prunes over time.
model DeviceToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  token    String @unique
  platform String // ANDROID | IOS | WEB

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@map("devicetoken")
}

