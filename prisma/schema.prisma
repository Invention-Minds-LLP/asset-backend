  consumableId Int?
  consumable   Consumable? @relation(fields: [consumableId], references: [id])

  quantity Decimal @db.Decimal(12, 2)

  referenceType String? // PURCHASE | TICKET | MANUAL | RETURN | GRA | WORK_ORDER | STORE_TRANSFER
  referenceId   Int?

  storeId         Int?
  workOrderId     Int?
  storeTransferId Int?

  performedById Int?
  performedBy   Employee? @relation(fields: [performedById], references: [id])

  notes String?

  createdAt DateTime @default(now())

  @@index([sparePartId])
  @@index([consumableId])
  @@index([storeId])
  @@map("inventorytransaction")
}

/**
 * =========================
 * NEW: Document vault (service file)
 * =========================
 */
model Document {
  id Int @id @default(autoincrement())

  entityType String // ASSET | TICKET | INSURANCE | CONTRACT | GATEPASS
  entityId   Int

  documentType String // INVOICE | PO | GRN | SERVICE_REPORT | CLAIM_DOC | CERTIFICATE
  title        String?
  fileUrl      String

  uploadedById Int?
  uploadedBy   Employee? @relation(fields: [uploadedById], references: [id])

  reason     String?
  uploadedAt DateTime @default(now())
  asset      Asset?   @relation(fields: [assetId], references: [id])
  assetId    Int?

