// One-time login codes for mobile OTP auth. `identifier` is either an
// employeeID (internal) or an email (external). otpHash is bcrypt(otp) so a
// DB leak doesn't expose live codes. A row is consumed (consumedAt set) on
// successful verify; rows past expiresAt or with attempts >= 5 are dead.
model LoginOtp {
  id             Int       @id @default(autoincrement())
  identifier     String
  identifierType String // "EMPLOYEE_ID" | "EXTERNAL_EMAIL"
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([identifier, identifierType])
  @@map("loginotp")
}

// Master record for external auditors that an admin can re-use across audits.
// Intentionally NOT FK-linked to AssetAuditor — when an audit is created,
// the auditor's details are SNAPSHOTTED into the AssetAuditor row so a later
// rename in this master doesn't rewrite history.
//
// Email is unique and is the identifier for external OTP login (Batch D).
// status=INACTIVE acts as a soft delete so historical audits keep their
// inline auditor row but the auditor can't log in anymore.
model ExternalAuditor {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  organization String?
  phone        String?
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE
  addedById    Int // User.id of the admin who added this auditor
  lastUsedAt   DateTime? // updated each time the auditor is attached to a new audit
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status])
  @@map("externalauditor")
}

