model StoreTransferItem {
  id              Int           @id @default(autoincrement())
  storeTransferId Int
  storeTransfer   StoreTransfer @relation(fields: [storeTransferId], references: [id])

  itemType     String // SPARE_PART | CONSUMABLE | ASSET
  sparePartId  Int?
  consumableId Int?
  assetId      Int?

  quantity    Decimal  @db.Decimal(12, 2)
  receivedQty Decimal? @db.Decimal(12, 2)
  remarks     String?

  createdAt DateTime @default(now())

  @@index([storeTransferId])
  @@map("storetransferitem")
}

// ═══════════════════════════════════════════════════════
// TCO COST ALLOCATION — Track non-standard cost types
// ═══════════════════════════════════════════════════════
model AssetCostAllocation {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation("CostAllocations", fields: [assetId], references: [id])

  costType    String // LABOR | UTILITY_POWER | SPACE_FACILITY | OUTSOURCED_SERVICE | CONSUMABLE | OTHER
  description String?
  amount      Decimal  @db.Decimal(14, 2)
  period      String? // e.g. "2025-Q1", "2025-03", "FY2025-26"
  entryDate   DateTime @default(now())

  referenceType String? // WORK_ORDER | INVOICE | MANUAL
  referenceId   Int?

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([assetId, costType])
  @@map("assetcostallocation")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET RATE CARD — Revenue configuration per asset
// ═══════════════════════════════════════════════════════════════════════════════
model AssetRateCard {
  id      Int   @id @default(autoincrement())
  assetId Int   @unique
  asset   Asset @relation("AssetRateCard", fields: [assetId], references: [id])

  // Revenue rate
  avgRevenuePerUnit Decimal @db.Decimal(12, 2) // average revenue per procedure/use/hour
  revenueUnit       String  @default("PER_USE") // PER_USE | PER_HOUR | PER_DAY | PER_PROCEDURE | PER_TEST | PER_BED_DAY
  currency          String  @default("INR")

  // Capacity configuration
  maxHoursPerDay     Decimal @default(24) @db.Decimal(5, 2) // max operable hours per day
  maxUsesPerDay      Int? // max procedures/tests per day (if applicable)
  plannedHoursPerDay Decimal @default(8) @db.Decimal(5, 2) // planned/scheduled hours per day

  // Operating schedule
  operatingDaysPerWeek Int     @default(6) // 5, 6, or 7
  shiftsPerDay         Int     @default(1) // 1, 2, or 3
  shiftDurationHours   Decimal @default(8) @db.Decimal(4, 2)

  // Benchmarks
  targetUtilizationPct Decimal @default(70) @db.Decimal(5, 2) // target % utilization
  targetOeeScore       Decimal @default(80) @db.Decimal(5, 2) // target OEE score (0-100)

  // Quality metric (for OEE)
  qualityPassRatePct Decimal @default(98) @db.Decimal(5, 2) // % of output that meets quality standards

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("assetratecard")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DAILY USAGE LOG — End-user reports daily asset usage
// ═══════════════════════════════════════════════════════════════════════════════
model AssetDailyUsageLog {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation("DailyUsageLogs", fields: [assetId], references: [id])

  logDate DateTime // the day being reported (DATE only, no time)

  // Usage metrics
  hoursUsed      Decimal @db.Decimal(5, 2) // actual hours the asset was operated
  procedureCount Int? // number of procedures/tests/uses (if applicable)
  patientsServed Int? // number of patients (for medical equipment)

  // Shift-wise breakdown (optional granularity)
  shift1Hours Decimal? @db.Decimal(4, 2) // morning shift hours
  shift2Hours Decimal? @db.Decimal(4, 2) // afternoon shift hours
  shift3Hours Decimal? @db.Decimal(4, 2) // night shift hours

  // Revenue from this day's usage
  revenueGenerated Decimal? @db.Decimal(12, 2) // actual revenue (if known)
  estimatedRevenue Decimal? @db.Decimal(12, 2) // calculated: hoursUsed * avgRevenuePerUnit (or procedureCount * rate)

  // Downtime tracking
  downtimeHours   Decimal? @default(0) @db.Decimal(5, 2)
  downtimeType    String? // PLANNED | UNPLANNED | MAINTENANCE | CALIBRATION | NO_DEMAND | POWER_OUTAGE | STAFF_UNAVAILABLE
  downtimeRemarks String?  @db.Text

  // OEE components (computed per day)
  availabilityPct Decimal? @db.Decimal(5, 2) // (plannedHours - downtimeHours) / plannedHours * 100
  performancePct  Decimal? @db.Decimal(5, 2) // actualOutput / theoreticalMaxOutput * 100
  qualityPct      Decimal? @db.Decimal(5, 2) // goodOutput / totalOutput * 100
  oeeScore        Decimal? @db.Decimal(5, 2) // availability * performance * quality / 10000

  // Condition after use
  conditionAfterUse String? // GOOD | NEEDS_ATTENTION | DEGRADED | CRITICAL

  // Who logged it
  loggedById   Int?
  loggedBy     Employee? @relation("UsageLoggedBy", fields: [loggedById], references: [id])
  verifiedById Int?
  verifiedAt   DateTime?
  status       String    @default("LOGGED") // LOGGED | VERIFIED | FLAGGED

  remarks String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([assetId, logDate])
  @@index([assetId, logDate])
  @@index([loggedById])
  @@map("assetdailyusagelog")
}

model MaterialRequest {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  itemType      String // SPARE_PART | CONSUMABLE | NEW_MATERIAL
  sparePartId   Int?
  consumableId  Int?
  description   String   @db.Text
  quantity      Decimal  @db.Decimal(12, 2)
  estimatedCost Decimal? @db.Decimal(12, 2)

  status String @default("PENDING") // PENDING | OPERATIONS_APPROVED | REJECTED | DELIVERED

  // Operations approval
  approvedById    Int?
  approvedAt      DateTime?
  approvalRemarks String?   @db.Text

  // Delivery timeframe
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  deliveryRemarks  String?

  requestedById Int?
  requestedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ticketId])
  @@index([status])
  @@map("materialrequest")
}

model ApprovalConfig {
  id        Int      @id @default(autoincrement())
  module    String // PURCHASE_ORDER | WORK_ORDER | DISPOSAL | MATERIAL_REQUEST
  level     Int // 1, 2, 3...
  roleName  String // HOD | OPERATIONS | FINANCE | CEO_COO | ADMIN
  minAmount Decimal  @db.Decimal(14, 2) // from this amount
  maxAmount Decimal? @db.Decimal(14, 2) // up to this amount (null = unlimited)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([module, level])
  @@map("approvalconfig")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET NATURE — Tangible vs Intangible classification
// ═══════════════════════════════════════════════════════════════════════════════
enum AssetNature {
  TANGIBLE
  INTANGIBLE
}

enum IntangibleSubType {
  SOFTWARE
  LICENSE
  PATENT
  COPYRIGHT
  TRADEMARK
  FRANCHISE_RIGHTS
  GOODWILL
  ACCREDITATION_RIGHTS
  SUBSCRIPTION
  OTHER
}

enum AmortizationMethod {
  STRAIGHT_LINE
  ACCELERATED
}

// ═══════════════════════════════════════════════════════════════════════════════
// ACCOUNTS MODULE ENUMS
// ═══════════════════════════════════════════════════════════════════════════════
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  POSTED
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  UPI
  BANK_TRANSFER
  DD
}

// ═══════════════════════════════════════════════════════════════════════════════
// CHART OF ACCOUNTS
// ═══════════════════════════════════════════════════════════════════════════════
model ChartOfAccount {
  id          Int              @id @default(autoincrement())
  code        String           @unique // 1001, 2001
  name        String
  type        AccountType
  subType     String? // "Fixed Asset", "Current Liability"
  description String?          @db.Text
  parentId    Int?
  parent      ChartOfAccount?  @relation("COAHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("COAHierarchy")
  isActive    Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  debitLines  JournalEntryLine[] @relation("DebitAccount")
  creditLines JournalEntryLine[] @relation("CreditAccount")

  // Finance Engine GL mapping back-relations
  glFixedAsset  AssetGLMapping[]     @relation("GLFixedAsset")
  glAccDep      AssetGLMapping[]     @relation("GLAccDep")
  glDepExp      AssetGLMapping[]     @relation("GLDepExp")
  glDisposal    AssetGLMapping[]     @relation("GLDisposal")
  glMaintenance AssetGLMapping[]     @relation("GLMaintenance")
  glInsurance   AssetGLMapping[]     @relation("GLInsurance")
  fvLines       FinanceVoucherLine[] @relation("FVLineAccount")

  // Export target fields for external systems
  tallyLedger String? // Tally Prime ledger name
  sapGlCode   String? // SAP GL account code
  zohoAccount String? // Zoho Books account name

  @@map("chartofaccount")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PURCHASE VOUCHER — Accounting entry for asset purchase
// ═══════════════════════════════════════════════════════════════════════════════
model PurchaseVoucher {
  id          Int           @id @default(autoincrement())
  voucherNo   String        @unique // PV-FY2025-001
  voucherDate DateTime
  amount      Decimal       @db.Decimal(14, 2)
  narration   String?       @db.Text
  status      VoucherStatus @default(DRAFT)

  // Standalone — manual asset reference (FK lives here)
  assetId Int?
  asset   Asset? @relation("AssetPurchaseVouchers", fields: [assetId], references: [id])

  // Procurement link — nullable, auto-filled when goods-receipt is accepted
  goodsReceiptId Int?
  goodsReceipt   GoodsReceipt? @relation("GRAPurchaseVouchers", fields: [goodsReceiptId], references: [id])

  // Vendor reference
  vendorId Int?
  vendor   Vendor? @relation("VendorPurchaseVouchers", fields: [vendorId], references: [id])

  // Invoice details (can exist without procurement module)
  invoiceNo     String?
  invoiceDate   DateTime?
  invoiceAmount Decimal?  @db.Decimal(14, 2)
  attachmentUrl String?

  // Approval
  approvedById    Int?
  approvedBy      Employee? @relation("PVApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalRemarks String?   @db.Text

  // Linked payments
  paymentVouchers PaymentVoucher[]
  journalEntries  JournalEntry[]

  createdById Int?
  createdBy   Employee? @relation("PVCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([voucherDate])
  @@map("purchasevoucher")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PAYMENT VOUCHER — Records payment against purchase voucher
// ═══════════════════════════════════════════════════════════════════════════════
model PaymentVoucher {
  id            Int           @id @default(autoincrement())
  voucherNo     String        @unique // PMT-FY2025-001
  voucherDate   DateTime
  amount        Decimal       @db.Decimal(14, 2)
  paymentMode   PaymentMode   @default(BANK_TRANSFER)
  bankReference String?
  bankName      String?
  narration     String?       @db.Text
  status        VoucherStatus @default(DRAFT)

  purchaseVoucherId Int?
  purchaseVoucher   PurchaseVoucher? @relation(fields: [purchaseVoucherId], references: [id])

  // Procurement linkage — an advance is paid against the order itself, long
  // before any purchase voucher exists.
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation("POPaymentVouchers", fields: [purchaseOrderId], references: [id])
  workOrderId     Int?
  workOrder       WorkOrder?     @relation("WOPaymentVouchers", fields: [workOrderId], references: [id])
  externalPoId    Int?
  externalPo      ExternalPurchaseOrder? @relation(fields: [externalPoId], references: [id])

  paymentType String @default("FULL") // ADVANCE | BALANCE | FULL | RETENTION

  // Payment gate — set by the three-way match or a missing commissioning
  // sign-off. A blocked voucher cannot be approved or posted.
  isBlocked   Boolean @default(false)
  blockReason String? @db.Text

  vendorId Int?
  vendor   Vendor? @relation("VendorPaymentVouchers", fields: [vendorId], references: [id])

  // Withholding. `amount` stays the gross liability being settled; the vendor
  // receives netAmount and the difference is owed to the department.
  tdsAmount     Decimal? @db.Decimal(14, 2)
  netAmount     Decimal? @db.Decimal(14, 2)
  /// The instructions the deduction was worked out under, not just its result.
  /// Posting recomputes from scratch, so without these a section chosen by hand
  /// or a deliberate waiver would be silently lost between draft and post.
  tdsSectionCode String?
  tdsWaived      Boolean @default(false)
  tdsWaiverReason String? @db.Text
  tdsDeductions TdsDeduction[] @relation("PaymentTdsDeductions")

  // Approval
  approvedById    Int?
  approvedBy      Employee? @relation("PMTApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalRemarks String?   @db.Text

  journalEntries JournalEntry[]

  createdById Int?
  createdBy   Employee? @relation("PMTCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([voucherDate])
  @@index([purchaseOrderId])
  @@index([externalPoId])
  @@map("paymentvoucher")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JOURNAL ENTRY — Double-entry bookkeeping
// ═══════════════════════════════════════════════════════════════════════════════
model JournalEntry {
  id              Int      @id @default(autoincrement())
  entryNo         String   @unique // JE-FY2025-001
  entryDate       DateTime
  narration       String?  @db.Text
  isAutoGenerated Boolean  @default(false)
  totalAmount     Decimal  @db.Decimal(14, 2)

  purchaseVoucherId Int?
  purchaseVoucher   PurchaseVoucher? @relation(fields: [purchaseVoucherId], references: [id])
  paymentVoucherId  Int?
  paymentVoucher    PaymentVoucher?  @relation(fields: [paymentVoucherId], references: [id])

  lines JournalEntryLine[]

  createdById Int?
  createdBy   Employee? @relation("JECreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([entryDate])
  @@map("journalentry")
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  debitAccountId  Int?
  debitAccount    ChartOfAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId Int?
  creditAccount   ChartOfAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id])

  amount    Decimal @db.Decimal(14, 2)
  narration String?

  @@index([journalEntryId])
  @@map("journalentryline")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FINANCE ENGINE — Config, GL Mappings, Auto-Vouchers, Export
// ═══════════════════════════════════════════════════════════════════════════════

enum AccountingMode {
  STANDALONE // Full double-entry within this app
  EXPORT // Generate vouchers, export to Tally/SAP/Zoho
  HYBRID // Both: internal ledger + periodic export
}

enum VoucherSourceType {
  ASSET_PURCHASE
  ASSET_DISPOSAL
  DEPRECIATION_BATCH
  MAINTENANCE
  INSURANCE
  MANUAL
}

enum FinanceVoucherStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REJECTED
  VOID
}

enum ExportTarget {
  TALLY_PRIME_XML
  TALLY_ERP9_CSV
  SAP_CSV
  ZOHO_BOOKS
  QUICKBOOKS
  EXCEL_GENERIC
}

enum ExportBatchStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Single-row config per tenant for the Finance module
model FinanceConfig {
  id              Int            @id @default(autoincrement())
  accountingMode  AccountingMode @default(STANDALONE)
  exportTarget    ExportTarget?
  autoVoucher     Boolean        @default(true) // auto-create draft vouchers on asset events
  requireApproval Boolean        @default(true) // FINANCE must approve before POSTED
  fyStartMonth    Int            @default(4) // 4 = April (Indian FY)
  defaultCurrency String         @default("INR")
  updatedById     Int?
  updatedBy       Employee?      @relation("FinanceConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt       DateTime       @default(now()) @updatedAt

  @@map("financeconfig")
}

/// Maps an AssetCategory to its GL accounts so auto-vouchers know which accounts to debit/credit
model AssetGLMapping {
  id              Int           @id @default(autoincrement())
  assetCategoryId Int           @unique
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id])

  // Fixed Asset account (DR on purchase, CR on disposal)
  fixedAssetAccountId Int?
  fixedAssetAccount   ChartOfAccount? @relation("GLFixedAsset", fields: [fixedAssetAccountId], references: [id])

  // Accumulated Depreciation account (CR on depreciation run)
  accDepAccountId Int?
  accDepAccount   ChartOfAccount? @relation("GLAccDep", fields: [accDepAccountId], references: [id])

  // Depreciation Expense account (DR on depreciation run)
  depExpenseAccountId Int?
  depExpenseAccount   ChartOfAccount? @relation("GLDepExp", fields: [depExpenseAccountId], references: [id])

  // Disposal account / P&L (DR/CR depending on gain or loss)
  disposalAccountId Int?
  disposalAccount   ChartOfAccount? @relation("GLDisposal", fields: [disposalAccountId], references: [id])

  // Maintenance Expense account (DR on maintenance cost)
  maintenanceAccountId Int?
  maintenanceAccount   ChartOfAccount? @relation("GLMaintenance", fields: [maintenanceAccountId], references: [id])

  // Insurance Expense account (DR on premium)
  insuranceAccountId Int?
  insuranceAccount   ChartOfAccount? @relation("GLInsurance", fields: [insuranceAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("assetglmapping")
}

/// A Finance Voucher — unified model for auto-generated and manual accounting entries
model FinanceVoucher {
  id          Int                  @id @default(autoincrement())
  voucherNo   String               @unique // FV-FY2025-001
  voucherDate DateTime
  narration   String?              @db.Text
  sourceType  VoucherSourceType    @default(MANUAL)
  sourceId    Int? // FK to Asset, AssetDisposal, BatchDepreciationRun, etc.
  totalDebit  Decimal              @db.Decimal(14, 2)
  totalCredit Decimal              @db.Decimal(14, 2)
  status      FinanceVoucherStatus @default(DRAFT)

  departmentId Int?
  department   Department? @relation("VoucherDept", fields: [departmentId], references: [id])

  batchRunId Int?
  batchRun   BatchDepreciationRun? @relation("VoucherBatchRun", fields: [batchRunId], references: [id])

  rejectionReason String? @db.Text

  lines       FinanceVoucherLine[]
  exportItems ExportBatchItem[]

  createdById  Int?
  createdBy    Employee? @relation("FVCreatedBy", fields: [createdById], references: [id])
  approvedById Int?
  approvedBy   Employee? @relation("FVApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([voucherDate])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("financevoucher")
}

/// Individual DR/CR lines of a Finance Voucher
model FinanceVoucherLine {
  id        Int            @id @default(autoincrement())
  voucherId Int
  voucher   FinanceVoucher @relation(fields: [voucherId], references: [id])

  accountId Int
  account   ChartOfAccount @relation("FVLineAccount", fields: [accountId], references: [id])

  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  narration String?

  costCentreId Int?
  costCentre   Department? @relation("FVLineCostCentre", fields: [costCentreId], references: [id])

  @@index([voucherId])
  @@map("financevoucherline")
}

/// Groups POSTED vouchers for batch export to Tally/SAP/etc.
model ExportBatch {
  id            Int               @id @default(autoincrement())
  batchNo       String            @unique // EXP-2025-001
  exportTarget  ExportTarget
  status        ExportBatchStatus @default(PENDING)
  fromDate      DateTime
  toDate        DateTime
  totalVouchers Int               @default(0)
  totalAmount   Decimal           @default(0) @db.Decimal(14, 2)
  fileUrl       String? // generated file path
  errorLog      String?           @db.Text

  items ExportBatchItem[]

  createdById Int?
  createdBy   Employee? @relation("ExportBatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@map("exportbatch")
}

/// Links a FinanceVoucher to an ExportBatch (many-to-many bridge)
model ExportBatchItem {
  id        Int            @id @default(autoincrement())
  batchId   Int
  batch     ExportBatch    @relation(fields: [batchId], references: [id])
  voucherId Int
  voucher   FinanceVoucher @relation(fields: [voucherId], references: [id])

  @@unique([batchId, voucherId])
  @@map("exportbatchitem")
}

/// Capex Budget — FINANCE/CEO can set annual capital expenditure budgets per department
model CapexBudget {
  id           Int            @id @default(autoincrement())
  fiscalYear   Int // 2025
  departmentId Int?
  department   Department?    @relation("CapexBudgetDept", fields: [departmentId], references: [id])
  categoryId   Int?
  category     AssetCategory? @relation("CapexBudgetCat", fields: [categoryId], references: [id])

  // Capital spend and running spend are budgeted separately and answer to
  // different people, so one table with a type beats two near-identical ones.
  budgetType String @default("CAPEX") // CAPEX | OPEX

  budgetAmount Decimal        @db.Decimal(14, 2)
  actualAmount Decimal        @default(0) @db.Decimal(14, 2) // auto-updated from asset purchases

  // Money spoken for but not yet spent. An approved order commits budget the
  // moment it exists — without this, a department can approve its way past its
  // allocation several times over while every screen still says it is fine.
  committedAmount Decimal @default(0) @db.Decimal(14, 2)

  notes        String?        @db.Text
  createdById  Int?
  createdBy    Employee?      @relation("CapexBudgetCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  commitments BudgetCommitment[]

  // Money moved in or out of this head after it was sanctioned. The original
  // allocation stays in budgetAmount so the two figures can be told apart —
  // "what was sanctioned" and "what we are working to" are different questions.
  originalAmount   Decimal? @db.Decimal(14, 2)
  transfersIn      Decimal  @default(0) @db.Decimal(14, 2)
  transfersOut     Decimal  @default(0) @db.Decimal(14, 2)
  supplementary    Decimal  @default(0) @db.Decimal(14, 2)
  surrendered      Decimal  @default(0) @db.Decimal(14, 2)

  /// Some heads are ring-fenced by whoever sanctioned them — grant money, a
  /// board-approved project — and cannot be raided for something else.
  isLocked     Boolean @default(false)
  lockedReason String? @db.Text

  movementsFrom BudgetMovement[] @relation("MovementFrom")
  movementsTo   BudgetMovement[] @relation("MovementTo")

  @@unique([fiscalYear, departmentId, categoryId, budgetType])
  @@map("capexbudget")
}

/**
 * RE-APPROPRIATION
 *
 * A budget head that will not be spent and another that has run out. Moving
 * money between them is routine, and doing it by editing two numbers destroys
 * the only record of what was originally sanctioned.
 *
 * Every movement is a row: transfer between heads, a supplementary grant, or
 * an unused balance handed back. The sanctioned figure never changes.
 */
model BudgetMovement {
  id            Int    @id @default(autoincrement())
  movementNumber String @unique // BM-FY2026-001

  /// TRANSFER — between two heads. SUPPLEMENTARY — new money in.
  /// SURRENDER — unused money handed back.
  movementType String @default("TRANSFER")

  fromBudgetId Int?
  fromBudget   CapexBudget? @relation("MovementFrom", fields: [fromBudgetId], references: [id])
  toBudgetId   Int?
  toBudget     CapexBudget? @relation("MovementTo", fields: [toBudgetId], references: [id])

  fiscalYear Int
  amount     Decimal @db.Decimal(14, 2)

  reason      String  @db.Text
  /// Why the source head will not need it — the half of the case people skip.
  sourceJustification String? @db.Text

  status String @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED | CANCELLED

  /// Slab the movement falls in, on the amount being moved.
  approvalLevel String?

  requestedById Int?
  requestedBy   Employee? @relation("MovementRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime  @default(now())

  approvedById  Int?
  approvedBy    Employee? @relation("MovementApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  approvalRemarks String? @db.Text

  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  appliedAt DateTime?

  /// What the two heads looked like before it moved, so the effect is legible
  /// afterwards without replaying every movement.
  fromBalanceBefore Decimal? @db.Decimal(14, 2)
  toBalanceBefore   Decimal? @db.Decimal(14, 2)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([fiscalYear, status])
  @@index([fromBudgetId])
  @@index([toBudgetId])
  @@map("budgetmovement")
}

// ═══════════════════════════════════════════════════════
// BUDGET COMMITMENT LEDGER
// ═══════════════════════════════════════════════════════
// Every reservation and release is a row, not just a number moving. A bare
// counter drifts the first time something is cancelled twice or a release is
// missed, and it cannot be reconciled afterwards.
model BudgetCommitment {
  id Int @id @default(autoincrement())

  capexBudgetId Int
  budget        CapexBudget @relation(fields: [capexBudgetId], references: [id], onDelete: Cascade)

  fiscalYear Int

  // What reserved it. A commitment always traces back to a document.
  purchaseOrderId Int?
  externalPoId    Int?
  indentId        Int?

  amount Decimal @db.Decimal(14, 2)

  // COMMITTED — reserved, not yet spent
  // RELEASED  — the order was cancelled or rejected, money handed back
  // CONSUMED  — goods arrived and the spend became actual
  status String @default("COMMITTED")

  releasedAt     DateTime?
  releaseReason  String?   @db.Text
  consumedAt     DateTime?

  notes String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([capexBudgetId, status])
  @@index([purchaseOrderId])
  @@map("budgetcommitment")
}

/// Manual Ledger Entry for adjustments / narration-only entries (no automatic GL effect)
/// Used in STANDALONE mode for narration / memo entries
model ManualLedgerEntry {
  id            Int      @id @default(autoincrement())
  entryNo       String   @unique // MLE-2025-001
  entryDate     DateTime
  narration     String   @db.Text
  amount        Decimal  @db.Decimal(14, 2)
  entryType     String // NOTE | ADJUSTMENT | MEMO
  referenceNo   String?
  attachmentUrl String?  @db.Text

  createdById Int?
  createdBy   Employee? @relation("MLECreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@map("manualledgerentry")
}

// ─── Asset Pool (Phased Digitization) ────────────────────────────────────────
// Represents a bulk placeholder for assets that haven't been individually
// digitized yet — e.g. FY2022-23 had 45 ICU assets captured as a single pool.
// As individual assets are entered they link back via assetPoolId on Asset.

model AssetPool {
  id               Int            @id @default(autoincrement())
  poolCode         String         @unique // e.g. POOL-ICU-FY2022-23-001
  financialYear    String // e.g. "FY2022-23"
  categoryId       Int?
  category         AssetCategory? @relation(fields: [categoryId], references: [id])
  departmentId     Int?
  department       Department?    @relation("AssetPoolDepartment", fields: [departmentId], references: [id])
  description      String?        @db.Text
  originalQuantity Int // total assets in this pool
  totalPoolCost    Decimal?       @db.Decimal(14, 2) // total cost captured from balance sheet
  status           String         @default("PENDING") // PENDING / PARTIAL / COMPLETE
  notes            String?        @db.Text
  createdById      Int?
  createdBy        Employee?      @relation("AssetPoolCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  assets                Asset[]
  adjustments           AssetPoolAdjustment[]
  depreciationSchedules AssetPoolDepreciationSchedule[]

  @@map("assetpool")
}

// One row per financial year per pool — uploaded from the audited FA register.
// Stores the auditor-certified gross block, accumulated dep, and net block
// so the FA schedule report can merge pool balances with individual asset rows.
model AssetPoolDepreciationSchedule {
  id               Int       @id @default(autoincrement())
  poolId           Int
  pool             AssetPool @relation(fields: [poolId], references: [id])
  financialYear    String // "FY2022-23"
  financialYearEnd DateTime // 31-Mar-2023

  openingGrossBlock   Decimal @db.Decimal(14, 2)
  additions           Decimal @default(0) @db.Decimal(14, 2)
  additionsFirstHalf  Decimal @default(0) @db.Decimal(14, 2) // Apr-Sep (full dep rate)
  additionsSecondHalf Decimal @default(0) @db.Decimal(14, 2) // Oct-Mar (half dep rate)
  deletions           Decimal @default(0) @db.Decimal(14, 2)
  deletionsFirstHalf  Decimal @default(0) @db.Decimal(14, 2) // Apr-Sep
  deletionsSecondHalf Decimal @default(0) @db.Decimal(14, 2) // Oct-Mar
  closingGrossBlock   Decimal @db.Decimal(14, 2)

  openingAccumulatedDep Decimal  @default(0) @db.Decimal(14, 2)
  depreciationRate      Decimal  @db.Decimal(5, 2) // e.g. 15.00
  depOnOpeningBlock     Decimal? @db.Decimal(14, 2) // dep on opening WDV at full rate
  depOnAdditions        Decimal? @db.Decimal(14, 2) // dep on additions (full + half combined)
  depreciationForPeriod Decimal  @db.Decimal(14, 2) // total = depOnOpening + depOnAdditions
  closingAccumulatedDep Decimal  @db.Decimal(14, 2)

  openingNetBlock Decimal @db.Decimal(14, 2)
  closingNetBlock Decimal @db.Decimal(14, 2)

  createdById Int?
  createdBy   Employee? @relation("AssetPoolDepSchedCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([poolId, financialYear])
  @@map("assetpooldepreciationschedule")
}

model AssetPoolAdjustment {
  id             Int       @id @default(autoincrement())
  poolId         Int
  pool           AssetPool @relation(fields: [poolId], references: [id])
  adjustmentType String // COST_RECONCILIATION / WRITE_OFF / DISTRIBUTE / OTHER
  amount         Decimal   @db.Decimal(14, 2)
  financialYear  String? // FY in which this adjustment was recorded
  reason         String?   @db.Text
  createdById    Int?
  createdBy      Employee? @relation("AssetPoolAdjCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())

  @@map("assetpooladjustment")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Service Invoice — bills received from vendors for services (repair/PM/AMC etc.)
// ═══════════════════════════════════════════════════════════════════════════════
model ServiceInvoice {
  id          Int       @id @default(autoincrement())
  invoiceNo   String // vendor invoice number
  invoiceDate DateTime
  dueDate     DateTime?

  // Link to the service event (only one will be set)
  ticketId              Int?
  ticket                Ticket?              @relation(fields: [ticketId], references: [id])
  maintenanceScheduleId Int?
  maintenanceSchedule   MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id])
  calibrationScheduleId Int?
  calibrationSchedule   CalibrationSchedule? @relation(fields: [calibrationScheduleId], references: [id])
  serviceContractId     Int?
  serviceContract       ServiceContract?     @relation(fields: [serviceContractId], references: [id])

  // Asset & vendor (can be auto-populated from linked event)
  assetId  Int?
  asset    Asset?  @relation(fields: [assetId], references: [id])
  vendorId Int?
  vendor   Vendor? @relation("ServiceInvoiceVendor", fields: [vendorId], references: [id])

  // Amounts
  invoiceAmount Decimal @db.Decimal(15, 2)
  gstPct        Decimal @default(18) @db.Decimal(5, 2)
  gstAmount     Decimal @default(0) @db.Decimal(15, 2)
  netAmount     Decimal @db.Decimal(15, 2) // invoiceAmount + gstAmount
  tdsAmount     Decimal @default(0) @db.Decimal(15, 2)
  payableAmount Decimal @db.Decimal(15, 2) // netAmount - tdsAmount

  serviceDescription String? @db.Text
  status             String  @default("PENDING_APPROVAL")
  // PENDING_APPROVAL → APPROVED → PAID | REJECTED

  // Payment details (filled when PAID)
  paidAt           DateTime?
  paymentMode      String? // CASH | CHEQUE | NEFT | UPI
  paymentRef       String?
  paymentVoucherId Int?

  // Document
  fileUrl String?

  remarks String? @db.Text

  createdById  Int?
  createdBy    Employee? @relation("ServiceInvoiceCreatedBy", fields: [createdById], references: [id])
  approvedById Int?
  approvedBy   Employee? @relation("ServiceInvoiceApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([assetId])
  @@index([vendorId])
  @@map("serviceinvoice")
}

// ── Reconciliation Snapshot ─────────────────────────────────────────────────
// Compares System-computed depreciation/value vs Books (accounts) vs Audit (FA register)
// Generated at FY-end or on demand for variance reporting and auditor sign-off.
model ReconciliationSnapshot {
  id         Int      @id @default(autoincrement())
  asOfDate   DateTime
  scope      String // ASSET | CATEGORY | POOL
  scopeId    Int // assetId / categoryId / poolId
  scopeLabel String? // human-readable (e.g. "MEDICAL EQUIPMENTS / FY2024-25")

  systemGrossBlock Decimal? @db.Decimal(15, 2)
  systemAccDep     Decimal? @db.Decimal(15, 2)
  systemNetBlock   Decimal? @db.Decimal(15, 2)

  booksGrossBlock Decimal? @db.Decimal(15, 2)
  booksAccDep     Decimal? @db.Decimal(15, 2)
  booksNetBlock   Decimal? @db.Decimal(15, 2)

  auditGrossBlock Decimal? @db.Decimal(15, 2)
  auditAccDep     Decimal? @db.Decimal(15, 2)
  auditNetBlock   Decimal? @db.Decimal(15, 2)

  varianceVsBooks    Decimal  @default(0) @db.Decimal(15, 2)
  varianceVsAudit    Decimal  @default(0) @db.Decimal(15, 2)
  variancePctVsBooks Decimal? @db.Decimal(8, 2)
  variancePctVsAudit Decimal? @db.Decimal(8, 2)
  varianceFlagged    Boolean  @default(false)

  status          String    @default("OPEN") // OPEN | RESOLVED | ACCEPTED
  resolutionNotes String?   @db.Text
  resolvedById    Int?
  resolvedBy      Employee? @relation("ReconResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?

  createdById Int?
  createdBy   Employee? @relation("ReconCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([asOfDate, scope])
  @@index([varianceFlagged])
  @@map("reconciliationsnapshot")
}

// ═══════════════════════════════════════════════════════
// DEMO / TRIAL LICENSING
// ═══════════════════════════════════════════════════════
// Terms of the demo running on THIS deployment. Single row — the lowest id wins.
//
// Every read is gated behind TRIAL_ENABLED=true in the environment, so a paying
// client's instance carries these two tables but never touches them: the guard
// short-circuits on the env check before any query. Checks also fail OPEN (no
// row, unreadable row, DB error → allow), because a licensing bug must never be
// able to lock a customer out of their own asset register.
model TrialLicense {
  id         Int      @id @default(autoincrement())
  clientName String
  status     String   @default("ACTIVE") // ACTIVE | REVOKED
  startsAt   DateTime @default(now())
  expiresAt  DateTime

  // One live session per user: a login revokes every earlier refresh token, so a
  // shared password kicks the previous person out instead of cloning access.
  // Far more reliable than IP matching, which consumer networks break daily.
  singleSession Boolean @default(true)

  // Employee IDs permitted to sign in during the trial (JSON array of strings).
  // Empty or null = no restriction.
  allowedEmployeeIds Json?

  ipMode     String  @default("ALERT") // OFF | ALERT | LOCK_FIRST | ALLOWLIST
  allowedIps Json? // ALLOWLIST mode: array of exact IPs, CIDRs, or "1.2.3.*"
  lockedIp   String? // LOCK_FIRST mode: bound on the first successful login

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("triallicense")
}

// Append-only audit of every trial rejection and every "someone else is using
// this login" signal. This is what tells you the demo credentials got shared.
model TrialViolation {
  id         Int      @id @default(autoincrement())
  occurredAt DateTime @default(now())
  reason     String // EXPIRED | REVOKED | IP_BLOCKED | NEW_IP | USER_NOT_ALLOWED | SESSION_TAKEOVER
  employeeId String?
  ipAddress  String?
  userAgent  String?  @db.Text
  path       String?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([reason])
  @@map("trialviolation")
}

// ═══════════════════════════════════════════════════════
// API ACCESS LOG + SECURITY MONITORING
// ═══════════════════════════════════════════════════════
// One row per API request (see src/middleware/accessLog.ts). `suspicious` marks
// requests that tripped a security rule (auth failure, brute force, file probe,
// injection signature in the URL); those also feed the batched email alerter in
// src/lib/securityAlert.ts. High-volume — the nightly retention purge in
// scheduler.ts trims rows past SECURITY_RETENTION_DAYS.
model ApiAccessLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  method      String // GET / POST / PUT / DELETE / PATCH
  path        String   @db.Text // request path (query string stripped)
  statusCode  Int // final HTTP status
  durationMs  Int // server processing time
  ip          String? // client IP (X-Forwarded-For aware, normalized)
  userAgent   String?  @db.Text
  userId      Int? // User.id from a valid token, null if anonymous
  employeeID  String? // employeeID from the token, for readability
  isAnonymous Boolean  @default(true) // true = no valid JWT presented
  suspicious  Boolean  @default(false) // true = a security rule flagged it
  reason      String? // which rule(s) flagged it, comma-separated

  @@index([createdAt])
  @@index([ip])
  @@index([suspicious])
  @@index([userId])
  @@map("apiaccesslog")
}

// ─────────────────────────────────────────────────────────────────────────────
// GOODS RETURN — rejected quantity going back to the vendor.
//
// Rejection is recorded on the receipt, but the return itself is a separate
// commercial event: the vendor either replaces the goods or issues a credit
// note, and until one of those lands the money is not settled.
// ─────────────────────────────────────────────────────────────────────────────
model GoodsReturn {
  id           Int      @id @default(autoincrement())
  returnNumber String   @unique
  returnDate   DateTime @default(now())

  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  reason String @db.Text

  // What settles this: a replacement delivery, or money back.
  settlementMode String @default("REPLACEMENT") // REPLACEMENT | CREDIT_NOTE | REFUND

  // DRAFT | SENT | ACKNOWLEDGED | REPLACED | CREDIT_NOTE_RECEIVED | CLOSED | CANCELLED
  status String @default("DRAFT")

  totalValue Decimal @default(0) @db.Decimal(14, 2)

  // Set when the vendor settles with money rather than goods. The credit note
  // reduces what is payable on the order.
  creditNoteNumber String?
  creditNoteDate   DateTime?
  creditNoteValue  Decimal?  @db.Decimal(14, 2)

  // Set when the vendor settles with a replacement delivery.
  replacementGrnId Int?

  dispatchedAt   DateTime?
  dispatchedVia  String?
  docketNumber   String?
  acknowledgedAt DateTime?

  raisedById  Int?
  closedById  Int?
  closedAt    DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines GoodsReturnLine[]

  @@index([goodsReceiptId])
  @@index([vendorId])
  @@index([status])
  @@map("goodsreturn")
}

model GoodsReturnLine {
  id            Int         @id @default(autoincrement())
  goodsReturnId Int
  goodsReturn   GoodsReturn @relation(fields: [goodsReturnId], references: [id], onDelete: Cascade)

  goodsReceiptLineId Int
  goodsReceiptLine   GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id])

  description String
  quantity    Int
  unitPrice   Decimal? @db.Decimal(12, 2)
  lineTotal   Decimal? @db.Decimal(14, 2)
  remarks     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([goodsReturnId])
  @@index([goodsReceiptLineId])
  @@map("goodsreturnline")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK RESERVATION — holds store stock against an indent.
//
// StoreStockPosition.reservedQty is a bare counter; it cannot say who holds a
// reservation, so nothing can release one selectively or let it lapse. This
// ledger does, and keeps that counter in step.
// ─────────────────────────────────────────────────────────────────────────────
model StockReservation {
  id      Int   @id @default(autoincrement())
  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  itemType     String // SPARE_PART | CONSUMABLE
  sparePartId  Int?
  consumableId Int?

  quantity Decimal @db.Decimal(12, 2)

  indentId Int?
  indent   AssetIndent? @relation(fields: [indentId], references: [id])

  indentLineId Int?

  // ACTIVE   — stock is held
  // CONSUMED — issued out against the indent
  // RELEASED — given up deliberately
  // EXPIRED  — lapsed unclaimed, swept back
  status String @default("ACTIVE")

  // A reservation nobody claims must not hold stock forever.
  expiresAt DateTime?

  reservedById  Int?
  releasedById  Int?
  releasedAt    DateTime?
  releaseReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([storeId, status])
  @@index([indentId])
  @@index([status, expiresAt])
  @@map("stockreservation")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPROVED VENDOR — who may be asked to quote, per category.
// ─────────────────────────────────────────────────────────────────────────────
model ApprovedVendor {
  id       Int    @id @default(autoincrement())
  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  assetCategoryId Int?
  assetCategory   AssetCategory? @relation("ApprovedVendorCategory", fields: [assetCategoryId], references: [id])

  itemType String? // ASSET | SPARE_PART | CONSUMABLE | SERVICE — null = all

  status String @default("APPROVED") // APPROVED | SUSPENDED | BLACKLISTED

  approvedById Int?
  approvedAt   DateTime  @default(now())
  validTo      DateTime?
  remarks      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, assetCategoryId, itemType])
  @@index([status])
  @@map("approvedvendor")
}

// ─────────────────────────────────────────────────────────────────────────────
// RATE CONTRACT — a price negotiated once and honoured for a period, so an
// annual rate does not have to be re-entered on every indent.
// ─────────────────────────────────────────────────────────────────────────────
model RateContract {
  id             Int    @id @default(autoincrement())
  contractNumber String @unique
  title          String

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  validFrom DateTime
  validTo   DateTime

  status String @default("ACTIVE") // DRAFT | ACTIVE | EXPIRED | TERMINATED

  documentUrl String?
  notes       String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lines RateContractLine[]

  @@index([vendorId])
  @@index([status])
  @@map("ratecontract")
}

model RateContractLine {
  id             Int          @id @default(autoincrement())
  rateContractId Int
  rateContract   RateContract @relation(fields: [rateContractId], references: [id], onDelete: Cascade)

  itemType    String // ASSET | SPARE_PART | CONSUMABLE | SERVICE
  description String

  assetCategoryId Int?
  assetCategory   AssetCategory? @relation("RateContractCategory", fields: [assetCategoryId], references: [id])

  sparePartId  Int?
  consumableId Int?

  unitPrice  Decimal  @db.Decimal(12, 2)
  taxPercent Decimal? @db.Decimal(5, 2)
  uom        String?

  minQty       Int?
  maxQty       Int?
  leadTimeDays Int?

  createdAt DateTime @default(now())

  @@index([rateContractId])
  @@index([assetCategoryId])
  @@map("ratecontractline")
}

// ─────────────────────────────────────────────────────────────────────────────
// INDENT LINE SPEC — specifications as attributes rather than prose, so what
// the asset department changed can be compared mechanically instead of read.
// ─────────────────────────────────────────────────────────────────────────────
model IndentLineSpec {
  id           Int             @id @default(autoincrement())
  indentLineId Int
  indentLine   AssetIndentLine @relation(fields: [indentLineId], references: [id], onDelete: Cascade)

  attribute String // "Detector type", "Channels", "Warranty"
  value     String // what the requesting department asked for

  // Set when the asset department proposes something different. Null means
  // the attribute was accepted as asked.
  revisedValue String?

  isMandatory Boolean @default(false)

  // UNCHANGED | CHANGED | ADDED | REMOVED — derived, stored for querying.
  changeStatus String @default("UNCHANGED")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([indentLineId])
  @@map("indentlinespec")
}