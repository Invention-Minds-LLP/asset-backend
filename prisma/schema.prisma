  referenceType   String? // PURCHASE_ORDER | WORK_ORDER | RETURNABLE_INWARD | SERVICE_RETURN | SAMPLE_DEMO | OTHER
  referenceNo     String? // PO / WO number (typed or copied from the linked record)
  purchaseOrderId Int? // optional link to PurchaseOrder (scalar, no relation)
  workOrderId     Int? // optional link to WorkOrder (scalar, no relation)

