/**
 * =========================
 * NEW: Gate Pass
 * =========================
 */
model GatePass {
  id         Int    @id @default(autoincrement())
  gatePassNo String @unique

  type   String // RETURNABLE | NON_RETURNABLE
  // Lifecycle — approval is TWO stages: the accountable department's HOD, then
  // Operations (falling back to CEO_COO where no Operations user exists).
  //
  // DRAFT → PENDING_APPROVAL → PENDING_OPS_APPROVAL → APPROVED
  //       → SECURITY_CLEARED → ISSUED → (RETURNED) → CLOSED
  //                ↘ REJECTED          ↘ REJECTED         ↘ CANCELLED
  //
  // SECURITY_CLEARED and ISSUED are deliberately separate. The supervisor
  // verifies the items and records the vehicle at the desk (cleared), the label
  // is printed, and only then does the parcel actually leave (issued). Collapsing
  // the two would stamp gatedOutAt while the goods were still on site, so
  // "when did this leave?" could never be answered honestly.
  //
  // A pass raised BY an HOD skips straight to PENDING_OPS_APPROVAL — raising it
  // is their endorsement, and leaving stage one in place would just put the pass
  // back in its own author's queue to approve.
  status String @default("DRAFT")

  // Multi-asset items now live in GatePassItem (junction table).
  // Legacy single-asset fields kept for backfill, dropped in a follow-up push.
  assetId     Int?
  asset       Asset?  @relation(fields: [assetId], references: [id])
  description String?
  quantity    Int?

  items GatePassItem[]

  issuedTo           String
  purpose            String
  expectedReturnDate DateTime?

  courierDetails String?
  vehicleNo      String?
  vehicleType    String? // HOSPITAL_VEHICLE | OUTSIDE_VEHICLE

  // ── Employee / movement details (from the physical gate-pass form) ──────────
  //
  // The five strings below are a SNAPSHOT, written at creation from the linked
  // employee/department. They stay strings because the printed pass must show
  // the details as they were when it was issued, even if the person later moves
  // department or changes number — and because the carrier is not always an
  // employee (couriers and vendor reps carry items out too, and have no record).
  carriedBy       String? // person physically carrying the items (may differ from issuedTo)
  employeeCode    String? // employee ID number
  employeeContact String? // employee contact number
  processDept     String? // process / department name
  toAddress       String? // destination address (the "TO." block on the paper form)

  // Real links behind that snapshot. Null for an external carrier, which is why
  // these supplement the strings rather than replacing them.
  carriedByEmployeeId Int?
  carriedByEmployee   Employee? @relation("GatePassCarriedBy", fields: [carriedByEmployeeId], references: [id])
  // Department accountable for the movement — not always the carrier's own
  // (a biomedical technician routinely carries an ICU asset).
  processDepartmentId Int?
  processDepartment   Department? @relation("GatePassProcessDept", fields: [processDepartmentId], references: [id])

  // ── Approval workflow (mandatory for both RETURNABLE & NON_RETURNABLE) ─────
  // Approver department is resolved ONCE at submit and stored, so the HOD inbox
  // query and the approval notification can't disagree. Resolution order:
  // first asset-linked item's department → requester's own department → null
  // (null falls back to notifying admins, so a pass is never orphaned).
  approverDepartmentId Int?
  approverDepartment   Department? @relation("GatePassApproverDept", fields: [approverDepartmentId], references: [id])

  approvalStatus     String    @default("PENDING") // PENDING | APPROVED | REJECTED | AUTO_APPROVED
  requestedById      Int?
  requestedBy        Employee? @relation("GatePassRequester", fields: [requestedById], references: [id])
  requestedAt        DateTime?
  approvedById       Int?
  approvedByEmployee Employee? @relation("GatePassApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  approvalRemarks    String?
  rejectionReason    String?

  // ── Stage two: Operations sign-off ────────────────────────────────────────
  // Separate columns rather than reusing approvedBy*, so the printed pass can
  // show both signatures and an audit can tell the two decisions apart.
  opsApprovedById    Int?
  opsApprovedBy      Employee? @relation("GatePassOpsApprover", fields: [opsApprovedById], references: [id])
  opsApprovedAt      DateTime?
  opsApprovalRemarks String?

  // Free-text fallbacks (kept for backwards compat with existing rows)
  approvedBy String?
  issuedBy   String?

  // ── Security verification (clear → gate-out → gate-in) ───────────────────
  // Desk clearance: items checked against the pass, transport recorded.
  securityClearedAt   DateTime?
  securityClearedById Int?
  securityClearedBy   Employee? @relation("GatePassSecurityCleared", fields: [securityClearedById], references: [id])

  // Actual departure.
  gatedOutAt   DateTime?
  gatedOutById Int?
  gatedOutBy   Employee? @relation("GatePassSecurityOut", fields: [gatedOutById], references: [id])
  gatedInAt    DateTime?
  gatedInById  Int?
  gatedInBy    Employee? @relation("GatePassSecurityIn", fields: [gatedInById], references: [id])

  // ── Label printing (security executive prints the sticker for the parcel) ──
  // Stamped when the compact label PDF is generated, so a supervisor can see
  // whether a parcel was labelled before releasing it, and two executives don't
  // print the same one twice.
  labelPrintedAt   DateTime?
  labelPrintedById Int?
  labelPrintedBy   Employee? @relation("GatePassLabelPrinter", fields: [labelPrintedById], references: [id])

  // Return tracking (whole pass — per-item return is on GatePassItem)
  returnedAt      DateTime?
  returnedBy      String?
  returnCondition String? // GOOD | DAMAGED | PARTIAL

  reason String?

  // Source linkage
  ticketId          Int?
  ticket            Ticket?               @relation(fields: [ticketId], references: [id])
  serviceVisitId    Int?                  @unique
  serviceVisit      ServiceVisit?         @relation("ServiceVisitGatePass", fields: [serviceVisitId], references: [id])
  transferHistoryId Int?
  transferHistory   AssetTransferHistory? @relation(fields: [transferHistoryId], references: [id])

  // Reverse relations
  ewasteRecords EWasteRecord[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  notifications Notification[]

  @@index([assetId, createdAt])
  @@index([approvalStatus, status])
  @@index([status, approverDepartmentId])
  @@index([gatedOutAt])
  @@map("gatepass")
}

model GatePassItem {
  id         Int      @id @default(autoincrement())
  gatePassId Int
  gatePass   GatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  // Optional: spares / surgical equipment sent out for repair may not be
  // registered assets. Such items are identified by description/make/model below.
  assetId Int?
  asset   Asset? @relation("GatePassItemAsset", fields: [assetId], references: [id])

  // Free-text identification (used for non-asset items, or to override/supplement
  // the linked asset's details).
  description String?
  make        String?
  model       String?

  quantity Int     @default(1)
  remarks  String?

  // Per-item return tracking (relevant when type=RETURNABLE)
  returnedAt      DateTime?
  returnCondition String? // GOOD | DAMAGED | PARTIAL
  returnRemarks   String?

  createdAt DateTime @default(now())

  @@index([gatePassId])
  @@index([assetId])
  @@map("gatepassitem")
}

