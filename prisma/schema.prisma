/**
 * =========================
 * NEW: QR Scan log + general asset scans
 * =========================
 */
model QRScanLog {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  scannedById Int?
  scannedBy   Employee? @relation(fields: [scannedById], references: [id])

  location String?
  action   String? // VIEW | TRANSFER | VERIFY

  scannedAt DateTime @default(now())

  @@index([assetId, scannedAt])
  @@map("qrscanlog")
}

model AssetScanLog {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  scannedById Int?
  scannedBy   Employee? @relation(fields: [scannedById], references: [id])

  scanType String? // RFID | QR | MARKER | MANUAL
  location String? // human-readable composed label, e.g. "Block A / 2 / ICU-3"
  notes    String?

  // ── Structured area (CCTV marker reader) ──
  // Reported by the reader from its per-camera config so the stale-location
  // check can compare a scan against the asset's active AssetLocation without
  // parsing `location`. isGate marks chokepoint cameras at the exit/gate.
  cameraId String?
  block    String?
  floor    String?
  room     String?
  isGate   Boolean @default(false)

  scannedAt DateTime @default(now())

  @@index([assetId, scannedAt])
  @@map("assetscanlog")
}

model Notification {
  id Int @id @default(autoincrement())

  // What the notification is about (optional links)
  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id])

  ticketId Int?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  gatePassId Int?
  gatePass   GatePass? @relation(fields: [gatePassId], references: [id])

  insuranceId Int?
  insurance   AssetInsurance? @relation(fields: [insuranceId], references: [id])

  claimId Int?
  claim   InsuranceClaim? @relation(fields: [claimId], references: [id])

  // Type + content
  type    String // WARRANTY_EXPIRY | INSURANCE_EXPIRY | AMC_CMC_EXPIRY | MAINTENANCE_DUE | SLA_BREACH | LOW_STOCK | GATEPASS_OVERDUE | OTHER
  title   String?
  message String  @db.Text

  // ✅ Relation 1: who created it
  createdById Int?
  createdBy   Employee? @relation("NotificationCreatedBy", fields: [createdById], references: [id])

  // ✅ Relation 2: direct employee link (optional “about/for” employee)
  employeeId Int?
  employee   Employee? @relation("NotificationEmployee", fields: [employeeId], references: [id])

  // Optional delivery metadata (still works even if you don’t implement channels now)
  priority String? // LOW | MEDIUM | HIGH | CRITICAL
  channel  String? // IN_APP | EMAIL | SMS | WHATSAPP

  // Helps you avoid duplicates from cron jobs
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  recipients NotificationRecipient[]

  @@index([assetId, createdAt])
  @@index([ticketId, createdAt])
  @@map("notification")
}

model NotificationRecipient {
  id Int @id @default(autoincrement())

  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id])

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Read / action tracking per employee
  isRead Boolean   @default(false)
  readAt DateTime?

  // Optional: delivery tracking (good for hospitals)
  deliveryStatus String? // PENDING | SENT | FAILED
  deliveredAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([notificationId, employeeId])
  @@index([employeeId, isRead, createdAt])
  @@map("notificationrecipient")
}

model NotificationPreference {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  warrantyExpiry  Boolean @default(true)
  insuranceExpiry Boolean @default(true)
  amcCmcExpiry    Boolean @default(true)
  maintenanceDue  Boolean @default(true)
  slaBreach       Boolean @default(true)
  lowStock        Boolean @default(true)
  gatepassOverdue Boolean @default(true)
  ticketUpdates   Boolean @default(true)
  assetTransfer   Boolean @default(true)

