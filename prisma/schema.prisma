  department String?
  receivedBy String? // who physically received it inside
  gatePassNo String? // linked outbound pass, for returnable inward

  // Returnable tracking
  returnDate DateTime?

  // Security
  securityGuardName String?
  senderAddress     String?
  timeOut           String?
  remarks           String?

