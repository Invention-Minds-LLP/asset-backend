// ═══════════════════════════════════════════════════════════════════════════════
// NEW: Asset Disposal — formal condemnation/disposal workflow
// ═══════════════════════════════════════════════════════════════════════════════
model AssetDisposal {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  disposalType String // CONDEMN | AUCTION | SCRAP | DONATE | RETURN_TO_VENDOR
  reason       String @db.Text
  status       String @default("REQUESTED") // REQUESTED | COMMITTEE_REVIEW | APPROVED | REJECTED | COMPLETED

  estimatedScrapValue Decimal? @db.Decimal(12, 2)
  actualSaleValue     Decimal? @db.Decimal(12, 2)
  bookValueAtDisposal Decimal? @db.Decimal(12, 2) // current book value when disposal was requested
  netGainLoss         Decimal? @db.Decimal(12, 2) // actualSaleValue - bookValueAtDisposal
  buyerName           String?
  buyerContact        String?

  // Committee approval
  committeeMembers      String?   @db.Text // JSON array of approver names/IDs
  committeeRemarks      String?   @db.Text
  committeeApprovalDate DateTime?

  requestedById Int?
  approvedById  Int?
  completedById Int?

  certificateUrl String? // Certificate of destruction / disposal proof
  documents      String? @db.Text // JSON array of document URLs

  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  eWasteRecord EWasteRecord?

  // ── Condemnation and clearance ──────────────────────────────────────────
  // committeeMembers above is a free-text list kept for the existing records.
  // These carry the actual proceedings: who inspected, who voted, and whether
  // the data on the thing was destroyed before it left the building.
  inspections   CondemnationInspection[]
  sanitisations DataSanitisation[]

  /// Value slab the write-off falls in, and how far it has been signed off.
  approvalLevel    String? // HOD | MANAGEMENT | COO | CFO
  levelApprovedUpto String?

  @@index([assetId])
  @@index([status])
  @@map("assetdisposal")
}

/**
 * CONDEMNATION
 *
 * Writing an asset off is a decision with a value on it, and one person should
 * not make it alone. A standing committee inspects, each member records their
 * own view, and the recommendation carries their names — which is exactly what
 * an auditor asks to see, and what a free-text list of names cannot provide.
 */
model CondemnationCommittee {
  id   Int    @id @default(autoincrement())
  name String @unique

  /// What this committee covers — a value ceiling, a category, a department.
  purpose      String? @db.Text
  maxValue     Decimal? @db.Decimal(14, 2)
  departmentId Int?
  department   Department? @relation("CommitteeDepartment", fields: [departmentId], references: [id])

  /// How many members have to record a view for the proceedings to stand.
  quorum Int @default(3)

  isActive Boolean @default(true)

  members     CondemnationCommitteeMember[]
  inspections CondemnationInspection[]

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("condemnationcommittee")
}

model CondemnationCommitteeMember {
  id          Int                   @id @default(autoincrement())
  committeeId Int
  committee   CondemnationCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation("CommitteeMemberships", fields: [employeeId], references: [id])

  /// CHAIR | TECHNICAL | FINANCE | USER_DEPARTMENT | SECRETARY | MEMBER
  /// A technical member is what makes "beyond economic repair" mean anything.
  role String @default("MEMBER")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([committeeId, employeeId])
  @@map("condemnationcommitteemember")
}

/// One sitting of the committee on one asset.
model CondemnationInspection {
  id Int @id @default(autoincrement())

  disposalId Int
  disposal   AssetDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)

  committeeId Int
  committee   CondemnationCommittee @relation(fields: [committeeId], references: [id])

  inspectionDate DateTime @default(now())

  /// What was found. "Beyond economic repair" is a conclusion, not a finding —
  /// the finding is what is broken and what fixing it would cost.
  physicalCondition String? @db.Text
  faultDescription  String? @db.Text
  isRepairable      Boolean @default(false)
  repairEstimate    Decimal? @db.Decimal(14, 2)
  /// Repair cost as a share of what a replacement costs. Past a threshold,
  /// repair stops being the sensible answer and the committee can say why.
  replacementCost   Decimal? @db.Decimal(14, 2)
  residualLifeMonths Int?
  sparesAvailable   Boolean?
  vendorSupportEnded Boolean?

  /// CONDEMN | REPAIR | RETAIN | REDEPLOY | REFER_BACK
  recommendation       String?
  recommendedDisposal  String? // AUCTION | SCRAP | DONATE | RETURN_TO_VENDOR | BUYBACK
  estimatedRealisation Decimal? @db.Decimal(14, 2)

  minutes String? @db.Text
  status  String  @default("IN_PROGRESS") // IN_PROGRESS | CONCLUDED | ABANDONED

  concludedAt DateTime?

  votes CondemnationVote[]

  convenedById Int?
  convenedBy   Employee? @relation("InspectionConvenedBy", fields: [convenedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([disposalId])
  @@map("condemnationinspection")
}

/// One member's own view, recorded separately so a dissent survives.
model CondemnationVote {
  id           Int                    @id @default(autoincrement())
  inspectionId Int
  inspection   CondemnationInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  memberId Int
  member   Employee @relation("CondemnationVotes", fields: [memberId], references: [id])

  /// CONDEMN | REPAIR | RETAIN | REDEPLOY | ABSTAIN
  decision String
  remarks  String? @db.Text

  signedAt DateTime @default(now())

  @@unique([inspectionId, memberId])
  @@map("condemnationvote")
}

/**
 * DATA SANITISATION
 *
 * An analyser, a PACS workstation, a school laptop — all of them leave the
 * building carrying patient or student records unless someone destroys them
 * first. The certificate is the only evidence that happened, and under the
 * DPDP Act the institution remains answerable for the data either way.
 *
 * Nothing holding personal data may complete disposal without this cleared.
 */
model DataSanitisation {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  disposalId Int?
  disposal   AssetDisposal? @relation(fields: [disposalId], references: [id])

  /// NONE | PATIENT | STUDENT | STAFF_PII | FINANCIAL | MIXED | UNKNOWN
  /// UNKNOWN is treated as if it held data — the safe default.
  dataClassification String @default("UNKNOWN")

  /// HDD | SSD | FLASH | TAPE | OPTICAL | EMBEDDED | PAPER | NONE
  mediaType     String?
  mediaSerialNo String?
  mediaRemoved  Boolean @default(false)

  /// OVERWRITE_NIST | CRYPTO_ERASE | DEGAUSS | PHYSICAL_DESTRUCTION |
  /// VENDOR_CERTIFIED | NOT_APPLICABLE
  method       String?
  methodDetail String? @db.Text
  /// An SSD cannot be degaussed and overwriting it is unreliable — the method
  /// has to suit the medium, and a mismatch is recorded rather than accepted.
  methodWarning String? @db.Text

  performedById   Int?
  performedBy     Employee? @relation("SanitisationPerformedBy", fields: [performedById], references: [id])
  performedAt     DateTime?
  /// Whoever did it does not sign it off — a second person verifies.
  verifiedById    Int?
  verifiedBy      Employee? @relation("SanitisationVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?

  certificateRef String?
  certificateUrl String?
  /// Where a vendor did the destruction, who they were.
  vendorName     String?

  status String @default("PENDING") // PENDING | IN_PROGRESS | DONE | VERIFIED | NOT_REQUIRED | FAILED

  notes String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([assetId])
  @@index([status])
  @@map("datasanitisation")
}

// ═══════════════════════════════════════════════════════════════════════════════
// E-Waste Management — post-scrap 3-stage sign-off chain
// Triggered automatically when AssetDisposal (type=SCRAP) is COMPLETED.
// ═══════════════════════════════════════════════════════════════════════════════
model EWasteRecord {
  id              Int           @id @default(autoincrement())
  eWasteRefNo     String        @unique // EW-2026-00001
  assetDisposalId Int           @unique
  assetDisposal   AssetDisposal @relation(fields: [assetDisposalId], references: [id])
  assetId         Int
  asset           Asset         @relation(fields: [assetId], references: [id])

  // Status flow
  status String @default("PENDING_HOD")
  // PENDING_HOD → PENDING_OPERATIONS → PENDING_SECURITY → CLOSED | REJECTED

  // Asset condition at time of e-waste handover
  assetCondition   String? // FUNCTIONAL | NON_FUNCTIONAL | DAMAGED
  assetDescription String? @db.Text

  // Data sanitisation (for IT assets)
  dataWiped       Boolean @default(false)
  dataWipeMethod  String? // DBAN | SECURE_ERASE | PHYSICAL_DESTRUCTION | NA
  dataWipeCertUrl String? // upload URL

  // Recycler details
  recyclerName    String?
  recyclerAuthNo  String? // CPCB authorization number
  recyclerContact String?
  handoverDate    DateTime?
  eWasteCertUrl   String? // certificate from recycler

  // ── Stage 1: HOD sign ──────────────────────────────────────────
  hodSignedById Int?
  hodSignedBy   Employee? @relation("EWasteHodSign", fields: [hodSignedById], references: [id])
  hodSignedAt   DateTime?
  hodSignature  String?   @db.LongText // base64 PNG of drawn signature
  hodRemarks    String?   @db.Text

  // ── Stage 2: Operations sign ────────────────────────────────────
  operationsSignedById Int?
  operationsSignedBy   Employee? @relation("EWasteOpsSign", fields: [operationsSignedById], references: [id])
  operationsSignedAt   DateTime?
  operationsSignature  String?   @db.LongText
  operationsRemarks    String?   @db.Text

  // ── Stage 3: Security sign ──────────────────────────────────────
  securitySignedById Int?
  securitySignedBy   Employee? @relation("EWasteSecSign", fields: [securitySignedById], references: [id])
  securitySignedAt   DateTime?
  securitySignature  String?   @db.LongText
  securityRemarks    String?   @db.Text
  gatePassNo         String? // legacy free-text reference (kept for backfill)
  gatePassId         Int?
  gatePass           GatePass? @relation(fields: [gatePassId], references: [id])

  closedAt    DateTime?
  createdById Int?
  createdBy   Employee? @relation("EWasteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([assetId])
  @@map("ewasterecord")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Asset Revenue Entry — manual provision to record revenue generated by an asset
// ═══════════════════════════════════════════════════════════════════════════════
model AssetRevenueEntry {
  id      Int   @id @default(autoincrement())
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  entryDate    DateTime
  revenueType  String // PROCEDURE | TEST | BED_CHARGE | RENTAL | SERVICE | OTHER
  description  String?  @db.Text
  quantity     Int      @default(1)
  unitRate     Decimal  @db.Decimal(12, 2)
  totalRevenue Decimal  @db.Decimal(12, 2) // quantity * unitRate

  referenceNo  String? // bill/invoice/order ref
  recordedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([assetId, entryDate])
  @@map("assetrevenueentry")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW: Asset Verification / Physical Audit
// ═══════════════════════════════════════════════════════════════════════════════
model AssetAudit {
  id        Int      @id @default(autoincrement())
  auditName String
  auditDate DateTime
  status    String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED

  departmentId Int?
  branchId     Int?

  // Floor-plan scope — reuses the floor plan captured in the location module.
  floor         String?
  block         String?
  floorPlanId   Int? // resolved FloorPlan for the audit's branch/floor (read-only consumer)
  categoryScope String? @db.Text // JSON [{id,name}] of category filter, for display

  auditorType String? // INTERNAL | EXTERNAL | BOTH

  // How the auditor walks the audit. Saved as the audit's default; the auditor
  // can still switch view while working, since it only changes traversal order.
  groupBy String @default("FLOOR") // FLOOR | DEPARTMENT | ASSET

  conductedById Int?
  description   String? @db.Text
  remarks       String? @db.Text

  totalAssets   Int @default(0)
  verifiedCount Int @default(0)
  missingCount  Int @default(0)
  mismatchCount Int @default(0)

  completedAt DateTime?

  items    AssetAuditItem[]
  auditors AssetAuditor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("assetaudit")
}

// Auditors assigned to an audit. INTERNAL rows reference an Employee by scalar
// id (no relation — matches AssetAudit's conductedById/branchId convention).
// EXTERNAL rows capture the auditor's details; `email` is the identifier used
// by the external email-OTP login (LoginOtp.identifierType = EXTERNAL_EMAIL).
model AssetAuditor {
  id      Int        @id @default(autoincrement())
  auditId Int
  audit   AssetAudit @relation(fields: [auditId], references: [id])

  type String // INTERNAL | EXTERNAL

  // Internal
  employeeId Int?

  // External
  name         String?
  email        String?
  organization String?
  phone        String?

  createdAt DateTime @default(now())

  @@index([auditId])
  @@map("assetauditor")
}

model AssetAuditItem {
  id      Int        @id @default(autoincrement())
  auditId Int
  audit   AssetAudit @relation(fields: [auditId], references: [id])

  assetId   Int
  asset     Asset     @relation("AuditItems", fields: [assetId], references: [id])
  status    String    @default("PENDING") // PENDING | VERIFIED | MISSING | MISMATCH
  scannedAt DateTime?

  // The asset's lifecycle status when the audit was created (ACTIVE, IN_STORE,
  // CONDEMNED, DISPOSED, UNDER_OBSERVATION…). Snapshotted so a completed audit
  // still reads correctly after the asset moves on.
  assetStatusAtAudit String?
  // Only ACTIVE assets must be accounted for before an audit can be closed.
  // Disposed / condemned ones are listed for completeness but never block it.
  isRequired Boolean @default(true)

  // Was the QR sticker physically on the asset when it was checked? A successful
  // scan proves PRESENT by definition; the manual path has to ask. Recorded here
  // as audit evidence as well as pushed onto Asset.qrStickered.
  stickerStatus    String? // PRESENT | MISSING | DAMAGED | NOT_APPLICABLE
  stickerCheckedAt DateTime?

  locationMatch   Boolean?
  conditionMatch  Boolean?
  actualLocation  String?
  actualCondition String?
  remarks         String?

  // Set when an internal User (employee auditor) verifies the item.
  verifiedById                Int?
  // Set when an external auditor (ExternalAuditor master row) verifies the
  // item via /api/external-audit/audit-items/:itemId/verify. Mutually
  // exclusive with verifiedById in practice; either, both null, or one is
  // populated depending on who verified.
  verifiedByExternalAuditorId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([auditId, status])
  @@index([assetId])
  @@map("assetaudititem")
}

// ═══════════════════════════════════════════════════════
// ASSET INDENT — New asset requirement / requisition
// ═══════════════════════════════════════════════════════
model AssetIndent {
  id           Int    @id @default(autoincrement())
  indentNumber String @unique // IND-FY2025-26-001

  // Requester
  raisedById   Int
  raisedBy     Employee   @relation("IndentRaisedBy", fields: [raisedById], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  branchId     Int?
  branch       Branch?    @relation("IndentBranch", fields: [branchId], references: [id])

  assetCategoryId Int?
  assetCategory   AssetCategory? @relation(fields: [assetCategoryId], references: [id])

  assetName       String // what asset is needed
  // How many quotes this purchase needs. Buying a machine the institution has
  // never owned deserves a comparison; adding another of something already in
  // use does not, provided the reason is recorded.
  // NEW_EQUIPMENT | ADDITIONAL | REPLACEMENT
  procurementType String    @default("NEW_EQUIPMENT")
  quantity        Int       @default(1)
  justification   String    @db.Text // why it's needed
  urgency         String    @default("NORMAL") // NORMAL | URGENT | CRITICAL
  estimatedBudget Decimal?  @db.Decimal(12, 2)
  requiredByDate  DateTime?
  specifications  String?   @db.Text

  // Approval chain
  // DRAFT | SUBMITTED | HOD_APPROVED | MANAGEMENT_APPROVED | STORE_REVIEW |
  // FULFILLED_FROM_STOCK | PROCUREMENT | DELIVERED | FULFILLED | CLOSED | REJECTED | CANCELLED
  status String @default("DRAFT")

  hodApprovalStatus String? // PENDING | APPROVED | REJECTED
  hodApprovedById   Int?
  hodApprovedBy     Employee? @relation("IndentApprovedBy", fields: [hodApprovedById], references: [id])
  hodApprovedAt     DateTime?
  hodRemarks        String?   @db.Text

  managementApprovalStatus String?
  managementApprovedBy     String?
  managementApprovedAt     DateTime?
  managementRemarks        String?   @db.Text

  // ── Asset department verification ──
  // A technical review before money is discussed: is the specification right,
  // and does the asset department already hold one?
  assetDeptId         Int? // resolved from the line categories at submission
  assetDeptStatus     String? // PENDING | VERIFIED | NEGOTIATING | ISSUED | REJECTED
  assetDeptVerifiedById Int?
  assetDeptVerifiedAt DateTime?
  assetDeptRemarks    String?  @db.Text

  // Store review — stores check their own stock before the indent reaches Purchase
  storeReviewStatus String? // PENDING | ISSUED_FROM_STOCK | PARTIAL | NOT_AVAILABLE
  storeReviewedById Int?
  storeReviewedAt   DateTime?
  storeRemarks      String?   @db.Text
  qtyFromStock      Int       @default(0) // issued out of existing stock
  qtyToProcure      Int? // balance forwarded to Purchase (null until reviewed)

  // Fulfillment
  fulfilledAt      DateTime?
  fulfilledAssetId Int?
  fulfilledAsset   Asset?    @relation("IndentFulfilledAsset", fields: [fulfilledAssetId], references: [id])

  // Delivery / closure — the indent closes when the end user acknowledges,
  // not when the goods receipt is accepted.
  deliveredAt DateTime?
  closedAt    DateTime?
  closedById  Int?

  rejectionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[] @relation("POLineIndent")
  storeIssues        IndentStoreIssue[]
  externalPOs        ExternalPurchaseOrder[]
  commissioningSignoffs CommissioningSignoff[]
  lines              AssetIndentLine[]
  negotiations       IndentSpecNegotiation[]
  quotations         PurchaseQuotation[]
  stockReservations  StockReservation[]

  @@index([departmentId, status])
  @@index([raisedById])
  @@index([branchId])
  @@map("assetindent")
}

// ═══════════════════════════════════════════════════════
// EMPLOYEE EXIT — Offboarding / asset handover process
// ═══════════════════════════════════════════════════════
model EmployeeExit {
  id         Int    @id @default(autoincrement())
  exitNumber String @unique // EXIT-2025-001

  employeeId Int
  employee   Employee @relation("ExitEmployee", fields: [employeeId], references: [id])

  exitType      String // RESIGNATION | TERMINATION | RETIREMENT | TRANSFER | DEPUTATION
  exitDate      DateTime // last working date
  initiatedDate DateTime @default(now())

  handledById Int?
  handledBy   Employee? @relation("ExitHandledBy", fields: [handledById], references: [id])

  status String @default("INITIATED") // INITIATED | ASSETS_LISTED | HANDOVER_IN_PROGRESS | CLEARED | CLOSED | PENDING_DUES

  // Asset handover summary
  totalAssetsAssigned Int @default(0)
  assetsReturned      Int @default(0)
  assetsPending       Int @default(0)

  // Handover items (assets to return)
  handoverItems EmployeeExitAsset[]

  exitRemarks   String? @db.Text
