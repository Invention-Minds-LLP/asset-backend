/**
 * =========================
 * NEW: Spares + Consumables
 * =========================
 */
model SparePart {
  id   Int    @id @default(autoincrement())
  name String

  partNumber String?
  model      String?
  category   String? // e.g., MONITOR, VENTILATOR, GENERAL

